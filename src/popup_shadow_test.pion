test "floating popups: toast window passes 3-sigma shadow_clip audit" {
  toast_wid.v = 0
  toast_text.set("Copied to clipboard")
  let t = ui::Tester::tree(toast_window, width=toast_w, height=toast_h)
  t.assert_shadow_clip(sigma=3.0, label="toast_window")
  t.dispose()
}

test "floating popups: rec_fps dropdown window passes 3-sigma shadow_clip audit" {
  rec_wid.v = 0
  rec_fps_wid.v = 0
  let w = rec_fps_card_w + rec_fps_pad_x * 2.0
  let h = rec_fps_card_h + rec_fps_pad_t + rec_fps_pad_b
  let t = ui::Tester::tree(rec_fps_window, width=w, height=h)
  t.assert_shadow_clip(sigma=3.0, label="rec_fps_window")
  t.dispose()
}

test "floating popups: rec_window (ready, recording + discard pill, export card) passes 3-sigma shadow_clip audit" {
  rec_wid.v = 0
  rec_fps_open.set(false)
  rec_morph_in.set(false)
  rec_tip.set("")

  rec_phase.set(0)
  rec_confirm_discard.set(false)
  let t = ui::Tester::tree(rec_window, width=480.0, height=bar_height + rec_pad_t + rec_pad_b)
  t.assert_shadow_clip(sigma=3.0, label="rec_window-ready")

  rec_phase.set(1)
  rec_ms.set(1500)
  rec_confirm_discard.set(true)
  t.frame(ms=16.0)
  t.assert_shadow_clip(sigma=3.0, label="rec_window-discard-pill")

  rec_confirm_discard.set(false)
  rec_phase.set(4)
  rec_part.v = Rect::{ x: 0, y: 0, w: 1920, h: 1080 }
  rec_master_bytes.set(4.0 * 1024.0 * 1024.0)
  t.frame(ms=16.0)
  let (cw, ch) = match rec_content.v {
    Some(c) => c.laid_size()
    None => (960.0, 540.0)
  }
  t.resize(cw, ch)
  t.frame(ms=16.0)
  t.assert_shadow_clip(sigma=3.0, label="rec_window-export-card")

  rec_root.v = None
  rec_content.v = None
  rec_confirm_discard.set(false)
  t.dispose()
}

test "floating popups: longshot panel (including detached jump pill inside clipped viewport) passes 3-sigma shadow_clip audit" {
  long_wid.v = 0
  long_part.v = Rect::{ x: 0, y: 0, w: 800, h: 600 }
  long_scale.v = 1.0
  long_box_h.v = 360.0
  long_h.set(2400)
  long_follow.set(false)
  long_dir.set(1)
  let w = long_panel_w + long_halo_x * 2.0
  let h = long_panel_h() + long_halo_t + long_halo_b
  let t = ui::Tester::tree(long_window, width=w, height=h)
  t.assert_shadow_clip(sigma=3.0, label="long_window")
  long_root.v = None
  t.dispose()
}

test "overlay: discard confirm pill wraps content width and anchors to cursor (right) or selection center (esc)" {
  mon.v = Rect::{ x: 0, y: 0, w: 3840, h: 2160 }
  mon_work.v = Rect::{ x: 0, y: 0, w: 3840, h: 2160 }
  mon_scale.set(2.0)
  sel.set(Some(Rect::{ x: 200, y: 200, w: 2164, h: 1540 }))
  overlay_confirm_discard.set("")
  overlay_discard_at.set(None)
  let t = ui::Tester::tree(overlay_window, width=1920.0, height=1080.0, scale=2.0, transitions_only=false)
  t.frame(ms=16.0)
  overlay_arm_discard("right", at=Some((900.0, 520.0)))
  t.run_shown(250.0)
  let (rx, ry, pw, ph) = match overlay_discard_pill.v {
    Some(dc) => dc.laid_window_now()
    None => (0.0, 0.0, 0.0, 0.0)
  }
  if pw <= 80.0 || pw >= 380.0 || (ph - 34.0).abs() > 0.5 {
    panic("overlay right discard pill size unexpected: \{pw}x\{ph}")
  }
  if ((rx + pw * 0.5) - 900.0).abs() > 2.0 || (ry - (520.0 - 34.0 - 14.0)).abs() > 2.0 {
    panic("overlay right discard pill not anchored above cursor: (\{rx}, \{ry}) size=\{pw}x\{ph}")
  }
  let right_alpha = match overlay_discard_pill.v {
    Some(dc) => dc.tree.nodes[dc.at].look.alpha
    None => -1.0
  }
  if right_alpha < 0.99 {
    panic("overlay right discard pill alpha stuck at \{right_alpha}")
  }
  overlay_discard_at.set(Some((12.0, 12.0)))
  t.frame(ms=16.0)
  let (cx0, cy0, _, _) = match overlay_discard_pill.v {
    Some(dc) => dc.laid_window_now()
    None => (0.0, 0.0, 0.0, 0.0)
  }
  if cx0 < 7.5 || cy0 < 28.0 {
    panic("overlay top-edge right discard pill did not flip/clamp: (\{cx0}, \{cy0})")
  }
  overlay_disarm_discard()
  t.frame(ms=16.0)
  overlay_arm_discard("esc")
  t.run_shown(250.0)
  let (ex, ey, ew, eh) = match overlay_discard_pill.v {
    Some(dc) => dc.laid_window_now()
    None => (0.0, 0.0, 0.0, 0.0)
  }
  if ew <= 80.0 || ew >= 380.0 || (eh - 34.0).abs() > 0.5 {
    panic("overlay esc discard pill size unexpected: \{ew}x\{eh}")
  }
  let want_cx = (200.0 + 2164.0 * 0.5) / 2.0
  let want_cy = (200.0 + 1540.0 * 0.5) / 2.0
  if ((ex + ew * 0.5) - want_cx).abs() > 2.0 || ((ey + eh * 0.5) - want_cy).abs() > 2.0 {
    panic("overlay esc discard pill not centered in selection: (\{ex}, \{ey}) size=\{ew}x\{eh} want_center=(\{want_cx}, \{want_cy})")
  }
  let esc_alpha = match overlay_discard_pill.v {
    Some(dc) => dc.tree.nodes[dc.at].look.alpha
    None => -1.0
  }
  if esc_alpha < 0.99 {
    panic("overlay esc discard pill alpha stuck at \{esc_alpha}")
  }
  overlay_disarm_discard()
  sel.set(None)
  overlay_root.v = None
  overlay_discard_pill.v = None
  t.dispose()
}
