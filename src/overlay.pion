import "hostapi"
import "motion"
import "pixels"
import "signals"
import "ui"
import "view"

let overlay_root : signals::Ref[Option[view::View]] = signals::ref_new(None)

fn now() -> Double {
  match overlay_root.v {
    Some(r) => r.cause_at()
    None => 0.0
  }
}

let accent : Int64 = 0x2F9BFFFFL

fn to_px(x : Double, y : Double) -> (Double, Double) {
  let k = mon_scale.untracked()
  (clamp(x * k, 0.0, mon.v.w.to_double()), clamp(y * k, 0.0, mon.v.h.to_double()))
}

fn mon_pt() -> (Double, Double) {
  let k = mon_scale.get()
  ignore(frozen_key.get())
  (mon.v.w.to_double() / k, mon.v.h.to_double() / k)
}

fn work_pt() -> (Double, Double, Double, Double) {
  let k = mon_scale.get()
  ignore(frozen_key.get())
  let w = mon_work.v
  if w.w > 0 && w.h > 0 {
    (w.x.to_double() / k, w.y.to_double() / k, w.right().to_double() / k, w.bottom().to_double() / k)
  } else {
    let (sw, sh) = mon_pt()
    (0.0, 0.0, sw, sh)
  }
}

fn handle_at(r : Rect, x : Double, y : Double) -> Option[(Int, Int)] {
  let reach = 6.0 * mon_scale.untracked()
  let x0 = r.x.to_double()
  let y0 = r.y.to_double()
  let x1 = r.right().to_double()
  let y1 = r.bottom().to_double()
  if x < x0 - reach || x > x1 + reach || y < y0 - reach || y > y1 + reach {
    return None
  }
  let hx = if (x - x0).abs() <= reach { -1 } else if (x - x1).abs() <= reach { 1 } else { 0 }
  let hy = if (y - y0).abs() <= reach { -1 } else if (y - y1).abs() <= reach { 1 } else { 0 }
  if hx == 0 && hy == 0 && !r.contains(x, y) {
    return None
  }
  Some((hx, hy))
}

fn side_cursor(side : (Int, Int)) -> view::Cursor {
  match side {
    (0, 0) => view::Cursor::Arrow
    (0, _) => view::Cursor::ResizeY
    (_, 0) => view::Cursor::ResizeX
    (-1, -1) | (1, 1) => view::Cursor::ResizeNWSE
    _ => view::Cursor::ResizeNESW
  }
}

fn overlay_cursor() -> Option[view::Cursor] {
  match cap_text.get() {
    Some(p) => return Some(cap_text_cursor(p))
    None => ()
  }
  match hand.get() {
    Drawing(_, _) | Marking | Erasing(_, _, _, _) => return Some(view::Cursor::Crosshair)
    Moving(_, _, _) | Dragging(_, _, _, _, _, -1, _) => return Some(view::Cursor::Arrow)
    Dragging(_, _, _, _, _, _, _) => return Some(view::Cursor::Crosshair)
    Sizing(hx, hy, _) => return Some(side_cursor((hx, hy)))
    Free => ()
  }
  match sel.get() {
    None => Some(view::Cursor::Crosshair)
    Some(r) => {
      let (x, y) = pointer_px.get()
      if selected_handle_at(x, y).is_some() {
        return Some(view::Cursor::Crosshair)
      }
      let t = tool.get()
      match handle_at(r, x, y) {
        Some((0, 0)) =>
          if t == Pen || t == Eraser {
            Some(view::Cursor::Crosshair)
          } else if t == Move || mark_at(x, y, false).is_some() {
            Some(view::Cursor::Arrow)
          } else {
            Some(view::Cursor::Crosshair)
          }
        Some(side) => Some(side_cursor(side))
        None => Some(view::Cursor::Arrow)
      }
    }
  }
}

fn clear_part() -> Option[Rect] {
  clear_part_now.get()
}

let clear_part_now : signals::Computed[Option[Rect]] = signals::computed_by(
  fn(_) {
    match sel.get() {
      Some(r) => Some(r)
      None => window_under()
    }
  },
  same=fn(a, b) {
    match (a, b) {
      (None, None) => true
      (Some(x), Some(y)) => x == y
      _ => false
    }
  },
)

fn chrome_picture(c : view::View) -> Option[pixels::Vector] {
  if !capturing.get() {
    return None
  }
  let w = mon.v.w.to_double()
  let h = mon.v.h.to_double()
  let k = mon_scale.get()
  let picked = sel.get().is_some()
  let layers : Array[pixels::VectorPath] = []
  match shown_part(c) {
    Some(r) => {
      let (x, y, rw, rh) = (r.x.to_double(), r.y.to_double(), r.w.to_double(), r.h.to_double())
      let hole = match shown_frame(c) {
        Some(f) => rect_path(f.x.to_double(), f.y.to_double(), f.w.to_double(), f.h.to_double())
        None => rect_path(x, y, rw, rh)
      }
      layers.push(fill_layer(rect_path(0.0, 0.0, w, h) + hole, 0x00000072L, even_odd=true))
      let line = dmax(1.5, (1.5 * k).round())
      let half = line / 2.0
      let fx0 = dmax(half, x - half)
      let fy0 = dmax(half, y - half)
      let fx1 = dmin(w - half, x + rw + half)
      let fy1 = dmin(h - half, y + rh + half)
      let fw = dmax(1.0, fx1 - fx0)
      let fh = dmax(1.0, fy1 - fy0)
      let cr = if picked && beauty_on.get() { dmin(beauty_corner * k + half, dmin(fw, fh) / 2.0) } else { 0.0 }
      let frame_r = if cr > 0.5 { superellipse_rect_path(fx0, fy0, fw, fh, cr) } else { rect_path(fx0, fy0, fw, fh) }
      let casing_w = line + dmax(2.0, (2.0 * k).round())
      if !picked {
        layers.push(stroke_layer(frame_r, 0x00000066L, casing_w))
        layers.push(stroke_layer(frame_r, 0x3DA6FFFFL, line))
        let bl = clamp(dmin(fw, fh) * 0.14, 7.0 * k, 14.0 * k)
        let crn = "M\{num(fx0)} \{num(fy0 + bl)}L\{num(fx0)} \{num(fy0)}L\{num(fx0 + bl)} \{num(fy0)}" +
          "M\{num(fx1 - bl)} \{num(fy0)}L\{num(fx1)} \{num(fy0)}L\{num(fx1)} \{num(fy0 + bl)}" +
          "M\{num(fx0)} \{num(fy1 - bl)}L\{num(fx0)} \{num(fy1)}L\{num(fx0 + bl)} \{num(fy1)}" +
          "M\{num(fx1 - bl)} \{num(fy1)}L\{num(fx1)} \{num(fy1)}L\{num(fx1)} \{num(fy1 - bl)}"
        let bw = dmax(2.0, (2.4 * k).round())
        layers.push(stroke_layer(crn, 0x00000066L, bw + dmax(2.0, (2.0 * k).round())))
        layers.push(stroke_layer(crn, 0x9ED8FFFFL, bw))
      } else {
        layers.push(stroke_layer(frame_r, 0x00000078L, casing_w))
        layers.push(stroke_layer(frame_r, 0xFFFFFFF2L, line))
        if !(hand.get() is Marking) && !cap_text_on() {
          let bl = clamp(dmin(fw, fh) * 0.16, 8.0 * k, 15.0 * k)
          let bw = dmax(2.5, (3.2 * k).round())
          let b_case = bw + dmax(2.0, (2.4 * k).round())
          let (rr, cc) = if cr > 0.5 { superellipse_params(fw, fh, cr) } else { (0.0, 0.0) }
          let ext = if rr > 0.5 { clamp(dmax(bl, rr + 5.0 * k), rr, dmin(fw, fh) * 0.42) } else { bl }
          let crn = if rr > 0.5 {
            if ext > rr + 0.25 {
              "M\{num(fx0)} \{num(fy0 + ext)}V\{num(fy0 + rr)}C\{num(fx0)} \{num(fy0 + cc)} \{num(fx0 + cc)} \{num(fy0)} \{num(fx0 + rr)} \{num(fy0)}H\{num(fx0 + ext)}" +
              "M\{num(fx1 - ext)} \{num(fy0)}H\{num(fx1 - rr)}C\{num(fx1 - cc)} \{num(fy0)} \{num(fx1)} \{num(fy0 + cc)} \{num(fx1)} \{num(fy0 + rr)}V\{num(fy0 + ext)}" +
              "M\{num(fx1)} \{num(fy1 - ext)}V\{num(fy1 - rr)}C\{num(fx1)} \{num(fy1 - cc)} \{num(fx1 - cc)} \{num(fy1)} \{num(fx1 - rr)} \{num(fy1)}H\{num(fx1 - ext)}" +
              "M\{num(fx0 + ext)} \{num(fy1)}H\{num(fx0 + rr)}C\{num(fx0 + cc)} \{num(fy1)} \{num(fx0)} \{num(fy1 - cc)} \{num(fx0)} \{num(fy1 - rr)}V\{num(fy1 - ext)}"
            } else {
              "M\{num(fx0)} \{num(fy0 + rr)}C\{num(fx0)} \{num(fy0 + cc)} \{num(fx0 + cc)} \{num(fy0)} \{num(fx0 + rr)} \{num(fy0)}" +
              "M\{num(fx1 - rr)} \{num(fy0)}C\{num(fx1 - cc)} \{num(fy0)} \{num(fx1)} \{num(fy0 + cc)} \{num(fx1)} \{num(fy0 + rr)}" +
              "M\{num(fx1)} \{num(fy1 - rr)}C\{num(fx1)} \{num(fy1 - cc)} \{num(fx1 - cc)} \{num(fy1)} \{num(fx1 - rr)} \{num(fy1)}" +
              "M\{num(fx0 + rr)} \{num(fy1)}C\{num(fx0 + cc)} \{num(fy1)} \{num(fx0)} \{num(fy1 - cc)} \{num(fx0)} \{num(fy1 - rr)}"
            }
          } else {
            "M\{num(fx0)} \{num(fy0 + bl)}L\{num(fx0)} \{num(fy0)}L\{num(fx0 + bl)} \{num(fy0)}" +
            "M\{num(fx1 - bl)} \{num(fy0)}L\{num(fx1)} \{num(fy0)}L\{num(fx1)} \{num(fy0 + bl)}" +
            "M\{num(fx0)} \{num(fy1 - bl)}L\{num(fx0)} \{num(fy1)}L\{num(fx0 + bl)} \{num(fy1)}" +
            "M\{num(fx1 - bl)} \{num(fy1)}L\{num(fx1)} \{num(fy1)}L\{num(fx1)} \{num(fy1 - bl)}"
          }
          layers.push(stroke_layer(crn, 0x00000080L, b_case))
          layers.push(stroke_layer(crn, 0xFFFFFFFFL, bw))

          let plen = (14.0 * k).round()
          let pthk = dmax(3.0, (3.4 * k).round())
          let pcase = dmax(1.0, (1.2 * k).round())
          let min_side = dmax(54.0 * k, ext * 2.0 + plen + 12.0 * k)
          let mx = (fx0 + fx1) / 2.0
          let my = (fy0 + fy1) / 2.0
          let mut pills_case = ""
          let mut pills = ""
          if fw >= min_side {
            let px = mx - plen / 2.0
            let py_t = fy0 - pthk / 2.0
            let py_b = fy1 - pthk / 2.0
            pills_case = pills_case +
              round_rect_path(px - pcase, py_t - pcase, plen + pcase * 2.0, pthk + pcase * 2.0, (pthk + pcase * 2.0) / 2.0) +
              round_rect_path(px - pcase, py_b - pcase, plen + pcase * 2.0, pthk + pcase * 2.0, (pthk + pcase * 2.0) / 2.0)
            pills = pills +
              round_rect_path(px, py_t, plen, pthk, pthk / 2.0) +
              round_rect_path(px, py_b, plen, pthk, pthk / 2.0)
          }
          if fh >= min_side {
            let py = my - plen / 2.0
            let px_l = fx0 - pthk / 2.0
            let px_r = fx1 - pthk / 2.0
            pills_case = pills_case +
              round_rect_path(px_l - pcase, py - pcase, pthk + pcase * 2.0, plen + pcase * 2.0, (pthk + pcase * 2.0) / 2.0) +
              round_rect_path(px_r - pcase, py - pcase, pthk + pcase * 2.0, plen + pcase * 2.0, (pthk + pcase * 2.0) / 2.0)
            pills = pills +
              round_rect_path(px_l, py, pthk, plen, pthk / 2.0) +
              round_rect_path(px_r, py, pthk, plen, pthk / 2.0)
          }
          if pills != "" {
            layers.push(fill_layer(pills_case, 0x00000080L))
            layers.push(fill_layer(pills, 0xFFFFFFFFL))
          }
        }
      }
    }
    None => layers.push(fill_layer(rect_path(0.0, 0.0, w, h), 0x00000072L))
  }
  Some(pixels::Vector::{ w, h, layers })
}

let overlay_owned : signals::Ref[Bool] = signals::ref_new(false)

fn overlay_first_frame() -> Unit {
  if overlay_owned.v || ui::current_window_id() != 0 {
    return
  }
  overlay_owned.v = true
  let _ = ps_own(0, 1)
  if !capturing.untracked() {
    ps_hide(0)
  }
  if started_with_settings.v {
    open_settings()
  } else if started_with_welcome.v {
    open_welcome()
  } else if hostapi::platform() != 0 && !capturing.untracked() && settings.untracked().capture_keep {
    warming.v = true
    log("warm-up: asked")
    ps_capture_ask()
    match overlay_root.v {
      Some(r) => {
        let _ = r.at_moment(now() + 2500.0, fn() {
          if warming.v && capturing.untracked() {
            log("warm-up: not drawn in 2.5 s, let go")
            close_capture()
          }
        }, later=true)
      }
      None => ()
    }
  }
}

let warming : signals::Ref[Bool] = signals::ref_new(false)

let overlay_confirm_discard : signals::Signal[String] = signals::signal("")

let overlay_discard_at : signals::Signal[Option[(Double, Double)]] = signals::signal_by(
  None,
  same=fn(a, b) {
    match (a, b) {
      (None, None) => true
      (Some((ax, ay)), Some((bx, by))) => ax == bx && ay == by
      _ => false
    }
  },
)

let overlay_discard_cancel : signals::Ref[() -> Unit] = signals::ref_new(fn() {  })

let overlay_discard_pill : signals::Ref[Option[view::View]] = signals::ref_new(None)

fn overlay_disarm_discard() -> Unit {
  (overlay_discard_cancel.v)()
  overlay_discard_cancel.v = fn() {  }
  if overlay_confirm_discard.untracked() != "" {
    overlay_confirm_discard.set("")
  }
  if overlay_discard_at.untracked().is_some() {
    overlay_discard_at.set(None)
  }
}

fn overlay_arm_discard(why : String, at~ : Option[(Double, Double)] = None) -> Unit {
  signals::start_batch()
  overlay_discard_at.set(at)
  overlay_confirm_discard.set(why)
  signals::end_batch()
  (overlay_discard_cancel.v)()
  match overlay_root.v {
    Some(root) =>
      overlay_discard_cancel.v = root.at_moment(
        root.cause_at() + 3000.0,
        fn() {
          overlay_discard_cancel.v = fn() {  }
          signals::start_batch()
          overlay_confirm_discard.set("")
          overlay_discard_at.set(None)
          signals::end_batch()
        },
        later=true,
      )
    None => ()
  }
}

fn overlay_window(root : view::View) -> Unit {
  overlay_root.v = Some(root)
  root.tree.hand_over_presses(false)
  let _ = root.ground(view::Live::Is(0x000000FFL)).keymap(view::Live::By(fn() { overlay_keys(settings.get().confirm_key) }))
  overlay_actions(root)
  // (seen once its first frame with the picture is on the screen: on Windows ps_cloak(0, 0) uncloaks inside
  // held_shown_now() only after Present + GPU finish + DwmFlush so a cold first frame can never flash black)
  root.reacts(fn() {
    let key = frozen_key.get()
    key != "" && root.image_ready(key, dmax(mon.v.w.to_double(), mon.v.h.to_double()))
  }, fn(ready) {
    if ready && capturing.untracked() && !overlay_seen.untracked() {
      if hostapi::platform() != 0 {
        if warming.v {
          overlay_seen.set(true)
          let _ = root.at_moment(root.cause_at() + 60.0, fn() { if warming.v { close_capture() } }, later=true)
          return
        }
        if ui::env("PINSHOT_TEST_CLOAKED") == "" {
          ps_cloak(0, 0)
        }
        overlay_seen.set(true)
        said_shown()
        return
      }
      let _ = root.at_moment(root.cause_at() + 1.0, fn() {
        if capturing.untracked() && warming.v {
          overlay_seen.set(true)
          let _ = root.at_moment(root.cause_at() + 60.0, fn() { if warming.v { close_capture() } }, later=true)
          return
        }
        if capturing.untracked() && !overlay_seen.untracked() {
          if ui::env("PINSHOT_TEST_CLOAKED") == "" {
            ps_cloak(0, 0)
          }
          overlay_seen.set(true)
          said_shown()
        }
      }, later=true)
    }
  })
  let _ = root.box(fn(stage) {
    let _ = stage
    .over(view::Live::Is(true))
    .presses(view::Live::Is(true))
    .cursor(view::Live::By(overlay_cursor))
    .on_pointer_moved(fn() {
      match stage.pointer_here() {
        Some((x, y)) => {
          let (px, py) = to_px(x, y)
          pointer_px.set((px, py))
          match cap_text.untracked() {
            Some(p) => cap_text_hover(p, px, py)
            None => ()
          }
        }
        None => ()
      }
    })
    .on_drag(fn(d) { stage_drag(d) })
    .on_menu(fn(m) { step_back(at=Some((m.x, m.y))) })
    let _ = stage.box(fn(p) {
      let _ = p
      .over(view::Live::Is(true))
      .image(view::Live::By(fn() {
        let key = frozen_key.get()
        if key == "" {
          None
        } else {
          Some((key, "", dmax(mon.v.w.to_double(), mon.v.h.to_double()).to_int()))
        }
      }))
      .presses(view::Live::Is(false))
    })
    shown_follow(stage)
    beauty_layer(stage)
    marks_layer(stage, editing=true)
    cap_text_layer(stage)
    let _ = stage.box(fn(c) { let _ = c.over(view::Live::Is(true)).presses(view::Live::Is(false)).picture(view::Live::By(fn() { chrome_picture(c) })) })
    size_label(stage)
    toolbar(stage)
    magnifier(stage)
  })
}

impl Eq for Mark {
  fn equal(a : Mark, b : Mark) -> Bool {
    same_mark(a, b)
  }
}

fn same_mark(a : Mark, b : Mark) -> Bool {
  if a.id != b.id || a.tool != b.tool || a.color != b.color || a.size != b.size || a.n != b.n || a.words != b.words || a.pts.length() != b.pts.length() {
    return false
  }
  for i, p in a.pts {
    let q = b.pts[i]
    if p.0 != q.0 || p.1 != q.1 {
      return false
    }
  }
  true
}

fn marks_layer(parent : view::View, editing~ : Bool) -> Unit {
  let _ = parent.box(fn(layer) {
    let _ = layer.over(view::Live::Is(true))
    let _ = layer.box(fn(f) { let _ = f.over(view::Live::Is(true)).presses(view::Live::Is(false)).picture(view::Live::By(focus_picture)) })
    layer.each(fn() { marks.get() }, fn(m) { m.id }, fn(row, m) {
      let _ = row.over(view::Live::Is(true)).presses(view::Live::Is(false))
      mark_node(row, signals::untracked(fn() { m.get() }))
    }, at_once=true)
    let _ = layer.box(fn(d) {
      let _ = d.over(view::Live::Is(true)).presses(view::Live::Is(false))
      let draft_seq = signals::ref_new(0)
      d.pick(fn() {
        let _ = draft.get()
        draft_seq.v = draft_seq.v + 1
        draft_seq.v
      }, fn(b, _) {
        let _ = b.over(view::Live::Is(true))
        match draft.untracked() {
          Some(m) => mark_node(b, m)
          None => ()
        }
      }, at_once=true)
    })
    if editing {
      let _ = layer.box(fn(h) { let _ = h.over(view::Live::Is(true)).presses(view::Live::Is(false)).picture(view::Live::By(picked_picture)) })
      words_editor(layer)
    }
  })
}

fn mark_node(b : view::View, m : Mark) -> Unit {
  let k = signals::untracked(fn() { mon_scale.get() })
  let w = mon.v.w.to_double()
  let h = mon.v.h.to_double()
  match m.tool {
    Words => words_mark(b, m, k)
    Blur => blur_mark(b, m, k)
    _ => {
      let layers = mark_layers(m, k)
      let _ = b.picture(view::Live::Is(Some(pixels::Vector::{ w, h, layers })))
      if m.tool == Number {
        let (cx, cy) = m.pts[0]
        let d = number_pt(m.size)
        let _ = b.box(fn(n) {
          let _ = n
          .width(view::Live::Is(Some(d)))
          .height(view::Live::Is(Some(d)))
          .offset(view::Live::Is((cx / k - d / 2.0, cy / k - d / 2.0)))
          .lines_up(view::Live::Is(Some(view::Along::Middle)))
          .lies_along(view::Live::Is(view::Lies::Middle))
          let _ = n.box(fn(t) {
            let _ = t
            .words(view::Live::Is(m.n.to_string()), look=view::WordsLook::{ ..view::words_plain,
              size: d * 0.56,
              weight: 700,
              line: d * 0.7,
              wrap: false,
            })
            .ink(view::Live::Is(if m.color == 0xFFFFFFFFL { 0x111214FFL } else { 0xFFFFFFFFL }))
          })
        })
      }
    }
  }
}

fn blur_mark(b : view::View, m : Mark, k : Double) -> Unit {
  guard blur_grid(m, k) is Some(g) else { return }
  let cell = g.cell.to_double()
  let _ = b.box(fn(o) {
    let _ = o.over(view::Live::Is(true)).lines_up(view::Live::Is(Some(view::Along::Start)))
    let _ = o.box(fn(c) {
      let _ = c
      .width(view::Live::Is(Some(g.r.w.to_double() / k)))
      .height(view::Live::Is(Some(g.r.h.to_double() / k)))
      .shrink(view::Live::Is(0.0))
      .offset(view::Live::Is((g.r.x.to_double() / k, g.r.y.to_double() / k)))
      .clips(view::Live::Is(true))
      .lines_up(view::Live::Is(Some(view::Along::Start)))
      let _ = c.box(fn(p) {
        let _ = p
        .width(view::Live::Is(Some(g.gw.to_double() * cell / k)))
        .height(view::Live::Is(Some(g.gh.to_double() * cell / k)))
        .shrink(view::Live::Is(0.0))
        .offset(view::Live::Is((-g.r.x.to_double() / k, -g.r.y.to_double() / k)))
        .image(view::Live::Is(Some((g.key, "", dmax(g.gw.to_double(), g.gh.to_double()).to_int()))))
      })
    })
  })
}

fn words_mark(b : view::View, m : Mark, k : Double) -> Unit {
  let (x, y) = m.pts[0]
  let size = words_pt(m.size)
  let _ = b.box(fn(t) {
    let _ = t
    .offset(view::Live::Is((x / k + 1.0, y / k)))
    .words(view::Live::Is(m.words), look=view::WordsLook::{ ..view::words_plain, size, weight: 400, line: (size * 1.3).round(), wrap: false })
    .ink(view::Live::Is(m.color))
  })
}

fn size_label(stage : view::View) -> Unit {
  let _ = stage.box(fn(o) {
    let _ = o.over(view::Live::Is(true)).presses(view::Live::Is(false)).lines_up(view::Live::Is(Some(view::Along::Start)))
    let _ = o.box(fn(l) {
      let badge_in = motion::NodeWay::new(if signals::untracked(fn() { clear_part().is_some() }) { 1.0 } else { 0.0 })
      l.reacts(fn() { clear_part().is_some() }, at_start=false, fn(on) {
        if on {
          badge_in.go_from(l, 0.0, 1.0, motion::tween(110.0, ease=ui::Ease::Out))
        } else {
          badge_in.put(0.0)
        }
      })
      let _ = l
      .row(view::Live::Is(true))
      .height(view::Live::Is(Some(24.0)))
      .padding(view::Live::Is((9.0, 0.0, 9.0, 0.0)))
      .radius(view::Live::Is(7.5))
      .ground(view::Live::Is(0x18191DF2L))
      .edge(view::Live::Is((1.0, 0xFFFFFF2AL)))
      .shadow(view::Live::Is((10.0, 3.0, 0x00000060L)))
      .alpha(view::Live::By(fn() { badge_in.shown(l) }))
      .lines_up(view::Live::Is(Some(view::Along::Middle)))
      .laid_nowhere(view::Live::By(fn() { clear_part().is_none() }))
      .offset(view::Live::By(fn() {
        let k = mon_scale.get()
        match shown_whole(l) {
          Some(r) => {
            let (wx0, wy0, wx1, wy1) = work_pt()
            let x = clamp(r.x.to_double() / k, wx0 + 8.0, dmax(wx0 + 8.0, wx1 - 160.0))
            let ry = r.y.to_double() / k
            let y = if ry >= wy0 + 34.0 {
              ry - 32.0
            } else {
              clamp(ry + 8.0, wy0 + 8.0, dmax(wy0 + 8.0, wy1 - 32.0))
            }
            (x, y)
          }
          None => (0.0, 0.0)
        }
      }))
      let _ = l.box(fn(t) {
        let _ = t
        .words(view::Live::By(fn() {
          match (clear_part(), beauty_frame()) {
            (Some(r), Some(f)) => "\{r.w} × \{r.h} → \{f.w} × \{f.h}"
            (Some(r), None) => "\{r.w} × \{r.h}"
            _ => ""
          }
        }), look=view::WordsLook::{ ..view::words_plain, size: 12.0, weight: 500, line: 16.0, wrap: false })
        .ink(view::Live::Is(0xF5F6F8FFL))
      })
    })
  })
  let _ = stage.box(fn(dw) {
    let _ = dw.over(view::Live::Is(true)).presses(view::Live::Is(false)).lines_up(view::Live::Is(Some(view::Along::Start)))
    let _ = dw.box(fn(dc) {
      overlay_discard_pill.v = Some(dc)
      let _ = dc.owns(fn() { overlay_discard_pill.v = None })
      let pill_h = 34.0
      let discard_in = motion::NodeWay::new(if signals::untracked(fn() { overlay_confirm_discard.get() != "" }) { 1.0 } else { 0.0 })
      dc.reacts(fn() { overlay_confirm_discard.get() != "" }, at_start=false, fn(on) {
        if on {
          discard_in.go_from(dc, 0.0, 1.0, motion::tween(120.0, ease=ui::Ease::Out))
        } else {
          discard_in.put(0.0)
        }
      })
      let _ = dc
      .presses(view::Live::Is(false))
      .row(view::Live::Is(true))
      .gap(view::Live::Is(7.0))
      .height(view::Live::Is(Some(pill_h)))
      .padding(view::Live::Is((11.0, 0.0, 14.0, 0.0)))
      .radius(view::Live::Is(10.0))
      .ground(view::Live::Is(0x991B1BF5L))
      .edge(view::Live::Is((1.0, 0xFECACA8CL)))
      .shadow(view::Live::Is((22.0, 8.0, 0x00000088L)))
      .alpha(view::Live::By(fn() { discard_in.shown(dc) }))
      .drawn_off(view::Live::By(fn() { (0.0, 4.0 * (1.0 - discard_in.shown(dc))) }))
      .lines_up(view::Live::Is(Some(view::Along::Middle)))
      .laid_nowhere(view::Live::By(fn() { overlay_confirm_discard.get() == "" }))
      .offset(view::Live::By(fn() {
        let k = mon_scale.get()
        let (wx0, wy0, wx1, wy1) = work_pt()
        let w = match dc.laid_size_told() {
          Some((pw, _)) if pw > 0.0 => pw
          _ => 200.0
        }
        let why = overlay_confirm_discard.get()
        if why == "right" {
          let (ax, ay) = match overlay_discard_at.get() {
            Some(p) => p
            None => {
              let (px, py) = pointer_px.untracked()
              (px / k, py / k)
            }
          }
          let x = clamp(ax - w * 0.5, wx0 + 8.0, dmax(wx0 + 8.0, wx1 - w - 8.0))
          let above = ay - pill_h - 14.0
          let y = if above >= wy0 + 8.0 {
            above
          } else {
            clamp(ay + 18.0, wy0 + 8.0, dmax(wy0 + 8.0, wy1 - pill_h - 8.0))
          }
          (x, y)
        } else {
          match shown_whole(dc) {
            Some(r) => {
              let cx = (r.x.to_double() + r.w.to_double() * 0.5) / k
              let cy = (r.y.to_double() + r.h.to_double() * 0.5) / k
              let x = clamp(cx - w * 0.5, wx0 + 8.0, dmax(wx0 + 8.0, wx1 - w - 8.0))
              let y = clamp(cy - pill_h * 0.5, wy0 + 8.0, dmax(wy0 + 8.0, wy1 - pill_h - 8.0))
              (x, y)
            }
            None =>
              (
                clamp((wx0 + wx1 - w) * 0.5, wx0 + 8.0, dmax(wx0 + 8.0, wx1 - w - 8.0)),
                clamp((wy0 + wy1 - pill_h) * 0.5, wy0 + 8.0, dmax(wy0 + 8.0, wy1 - pill_h - 8.0)),
              )
          }
        }
      }))
      let _ = dc.box(fn(ic) {
        let _ = ic
        .width(view::Live::Is(Some(16.0)))
        .height(view::Live::Is(Some(16.0)))
        .picture(view::Live::Is(Some(pixels::Vector::{
          w: 16.0,
          h: 16.0,
          layers: [
            stroke_layer("M8 2.2 14.2 13H1.8L8 2.2Z", 0xFECACAFFL, 1.5),
            stroke_layer("M8 6.1v3.2", 0xFFF5F5FFL, 1.6),
            fill_layer(circle_path(8.0, 11.2, 0.9), 0xFFF5F5FFL),
          ],
        })))
      })
      let _ = dc.box(fn(t) {
        let _ = t
        .words(view::Live::By(fn() {
          if overlay_confirm_discard.get() == "right" {
            tr("再按一次右键放弃标注")
          } else {
            tr("再按一次 Esc 放弃标注")
          }
        }), look=view::WordsLook::{ ..view::words_plain, size: 13.0, weight: 600, line: 18.0, wrap: false })
        .ink(view::Live::Is(0xFFF5F5FFL))
      })
    })
  })
}

let down_at : signals::Ref[(Double, Double, Bool)] = signals::ref_new((0.0, 0.0, false))

let words_put_down : signals::Ref[Bool] = signals::ref_new(false)

fn stage_drag(d : view::Drag) -> Unit {
  let (x, y) = to_px(d.x, d.y)
  pointer_px.set((x, y))
  match cap_text.untracked() {
    Some(p) => {
      cap_text_drag(p, d, x, y)
      return
    }
    None => ()
  }
  match d.kind {
    Down => press_down(x, y)
    Moved => {
      let (x0, y0, moved) = down_at.v
      let k = mon_scale.untracked()
      if !moved && ((x - x0).abs() >= 3.0 * k || (y - y0).abs() >= 3.0 * k) {
        down_at.v = (x0, y0, true)
      }
      press_moved(x, y)
    }
    Up => press_up(x, y)
    Off => drop_held()
  }
}

fn drop_held() -> Unit {
  signals::start_batch()
  match hand.untracked() {
    Dragging(_, _, _, before, _, _, _) | Erasing(before, _, _, _) => marks.set(before)
    _ => ()
  }
  draft.set(None)
  hand.set(Free)
  signals::end_batch()
}

fn dragged(m : Mark, dx : Double, dy : Double) -> Mark {
  if m.tool == Mosaic {
    let cell = dmax(2.0, (mosaic_pt(m.size) * mon_scale.untracked()).round())
    moved_by(m, (dx / cell).round() * cell, (dy / cell).round() * cell)
  } else {
    moved_by(m, dx, dy)
  }
}

fn held_to(m : Mark, hx : Int, hy : Int, x0 : Double, y0 : Double, x : Double, y : Double) -> Mark {
  if hx < 0 {
    return dragged(m, x - x0, y - y0)
  }
  let (x, y) = if (m.tool == Line || m.tool == Arrow) && ps_shift_down() == 1 {
    let (ox, oy) = m.pts[if hx == 0 { m.pts.length() - 1 } else { 0 }]
    snap45(ox, oy, x, y)
  } else {
    (x, y)
  }
  reshaped(m, hx, hy, x, y)
}

fn selected_handle_at(x : Double, y : Double) -> Option[(Int, Int, Int)] {
  guard selected.get() is Some(id) && mark_index(id) is Some(i) else { return None }
  let reach = 7.0 * mon_scale.untracked()
  for h in mark_handles(marks.untracked()[i]) {
    let (hx, hy, px, py) = h
    if (x - px).abs() <= reach && (y - py).abs() <= reach {
      return Some((i, hx, hy))
    }
  }
  None
}

fn take_up(i : Int, x : Double, y : Double, hx : Int, hy : Int) -> Unit {
  let before = marks.untracked()
  let rest = before.copy()
  let m = rest[i]
  ui::array_remove_at(rest, i)
  signals::start_batch()
  marks.set(rest)
  draft.set(Some(m))
  selected.set(Some(m.id))
  hand.set(Dragging(x, y, m, before, i, hx, hy))
  signals::end_batch()
}

fn press_down(x : Double, y : Double) -> Unit {
  overlay_disarm_discard()
  down_at.v = (x, y, false)
  words_put_down.v = false
  if words_open.untracked().is_some() {
    commit_words()
    words_put_down.v = true
  }
  if selected_handle_at(x, y) is Some((i, hx, hy)) {
    take_up(i, x, y, hx, hy)
    return
  }
  match sel.untracked() {
    None => hand.set(Drawing(x, y))
    Some(r) =>
      match handle_at(r, x, y) {
        Some((0, 0)) => {
          let cur_tool = tool.untracked()
          if cur_tool == Eraser {
            selected.set(None)
            let before = marks.untracked()
            let hit = erase_pen_segment(x, y, x, y)
            erase_at.v = (x, y, hit)
            hand.set(Erasing(before, x, y, hit))
          } else if cur_tool == Pen {
            selected.set(None)
            hand.set(Marking)
            draft.set(Some(new_mark(Pen, [(x, y), (x, y)])))
          } else {
            match mark_at(x, y, cur_tool == Move) {
              Some(i) => take_up(i, x, y, -1, -1)
              None => {
                selected.set(None)
                match cur_tool {
                  Move => hand.set(Moving(x, y, r))
                  Number | Words => hand.set(Marking)
                  t => {
                    hand.set(Marking)
                    let start = if t == Mosaic {
                      let cell = dmax(2.0, (mosaic_pt(size_now.untracked()) * mon_scale.untracked()).round())
                      ((x / cell).floor() * cell, (y / cell).floor() * cell)
                    } else {
                      (x, y)
                    }
                    draft.set(Some(new_mark(t, [start, start])))
                  }
                }
              }
            }
          }
        }
        Some((hx, hy)) => {
          selected.set(None)
          hand.set(Sizing(hx, hy, r))
        }
        None =>
          match beauty_frame() {
            Some(f) if f.contains(x, y) => ()
            _ => if marks.untracked().length() == 0 { hand.set(Drawing(x, y)) }
          }
      }
  }
}

let erase_at : signals::Ref[(Double, Double, Bool)] = signals::ref_new((0.0, 0.0, false))

fn press_moved(x : Double, y : Double) -> Unit {
  let (_, _, moved) = down_at.v
  let w = mon.v.w
  let h = mon.v.h
  match hand.untracked() {
    Drawing(x0, y0) =>
      if moved {
        let r = rect_between(x0.round().to_int(), y0.round().to_int(), x.round().to_int(), y.round().to_int())
        sel.set(r.within(w, h))
      }
    Moving(x0, y0, r) => {
      let nx = clampi(r.x + (x - x0).round().to_int(), 0, w - r.w)
      let ny = clampi(r.y + (y - y0).round().to_int(), 0, h - r.h)
      sel.set(Some({ ..r, x: nx, y: ny }))
    }
    Sizing(hx, hy, r) => {
      let xi = x.round().to_int()
      let yi = y.round().to_int()
      let x0 = if hx < 0 { xi } else { r.x }
      let x1 = if hx > 0 { xi } else { r.right() }
      let y0 = if hy < 0 { yi } else { r.y }
      let y1 = if hy > 0 { yi } else { r.bottom() }
      match rect_between(x0, y0, x1, y1).within(w, h) {
        Some(n) if n.w >= 1 && n.h >= 1 => sel.set(Some(n))
        _ => ()
      }
    }
    Dragging(x0, y0, m, _, _, hx, hy) => if moved { draft.set(Some(held_to(m, hx, hy, x0, y0, x, y))) }
    Erasing(_, _, _, _) => {
      let (lx, ly, hit) = erase_at.v
      let (cx, cy) = clamp_to_sel(x, y)
      let hit2 = erase_pen_segment(lx, ly, cx, cy)
      erase_at.v = (cx, cy, hit || hit2)
    }
    Marking =>
      match draft.untracked() {
        Some(m) => {
          let (cx, cy) = clamp_to_sel(x, y)
          let (cx, cy) = if m.tool == Mosaic {
            let cell = dmax(2.0, (mosaic_pt(m.size) * mon_scale.untracked()).round())
            let snap = fn(v : Double, from : Double) {
              if v >= from {
                (v / cell).ceil() * cell
              } else {
                (v / cell).floor() * cell
              }
            }
            (snap(cx, m.pts[0].0), snap(cy, m.pts[0].1))
          } else {
            (cx, cy)
          }
          let last_pt = m.pts[m.pts.length() - 1]
          if m.tool == Mosaic && last_pt.0 == cx && last_pt.1 == cy {
            return
          }
          let (cx, cy) = if (m.tool == Line || m.tool == Arrow) && ps_shift_down() == 1 {
            let (sx, sy) = snap45(m.pts[0].0, m.pts[0].1, cx, cy)
            clamp_to_sel(sx, sy)
          } else {
            (cx, cy)
          }
          let pts = if m.tool == Pen || m.tool == MosaicBrush {
            let (lx, ly) = m.pts[m.pts.length() - 1]
            let dx = cx - lx
            let dy = cy - ly
            let min_step = if m.tool == MosaicBrush { 2.0 * mon_scale.untracked() } else { 0.5 }
            if dx * dx + dy * dy < min_step * min_step {
              return
            }
            let p = m.pts.copy()
            p.push((cx, cy))
            p
          } else {
            [m.pts[0], (cx, cy)]
          }
          draft.set(Some(Mark::{ ..m, pts, }))
        }
        None => ()
      }
    Free => ()
  }
}

fn clamp_to_sel(x : Double, y : Double) -> (Double, Double) {
  match sel.untracked() {
    Some(r) =>
      (clamp(x, r.x.to_double(), r.right().to_double()), clamp(y, r.y.to_double(), r.bottom().to_double()))
    None => (x, y)
  }
}

let last_click : signals::Ref[(Double, Double, Double)] = signals::ref_new((0.0, 0.0, 0.0))

let last_click_undo : signals::Ref[Bool] = signals::ref_new(false)

fn second_click(x : Double, y : Double) -> Bool {
  let t = ps_now_ms()
  let (lt, lx, ly) = last_click.v
  let reach = 4.0 * mon_scale.untracked()
  if t - lt <= 500.0 && (x - lx).abs() <= reach && (y - ly).abs() <= reach {
    last_click.v = (0.0, 0.0, 0.0)
    true
  } else {
    last_click.v = (t, x, y)
    false
  }
}

fn press_up(x : Double, y : Double) -> Unit {
  let (_, _, moved) = down_at.v
  if moved {
    last_click.v = (0.0, 0.0, 0.0)
    last_click_undo.v = false
  } else if second_click(x, y) {
    match sel.untracked() {
      Some(r) if r.contains(x, y) => {
        drop_held()
        if words_open.untracked().is_some() {
          words_open.set(None)
        }
        if last_click_undo.v {
          let _ = undo()
          last_click_undo.v = false
        }
        copy_out()
        return
      }
      _ => last_click_undo.v = false
    }
  } else {
    last_click_undo.v = false
  }
  match hand.untracked() {
    Drawing(_, _) =>
      if !moved {
        sel.set(window_at(x, y))
      } else {
        match sel.untracked() {
          Some(r) if r.w < 2 || r.h < 2 => sel.set(None)
          _ => ()
        }
      }
    Dragging(x0, y0, m, before, i, hx, hy) => {
      signals::start_batch()
      draft.set(None)
      marks.set(before)
      if moved {
        replace_mark(i, held_to(m, hx, hy, x0, y0, x, y))
      } else {
        color_now.set(m.color)
        size_now.set(m.size)
      }
      hand.set(Free)
      signals::end_batch()
      return
    }
    Erasing(before, _, _, _) => {
      let (_, _, hit) = erase_at.v
      if hit {
        done_before.v.push(before)
        undone.v = []
        if !moved {
          last_click_undo.v = true
        }
      }
      hand.set(Free)
      return
    }
    Marking =>
      match tool.untracked() {
        Number => {
          add_mark(new_mark(Number, [(x, y)]))
          if !moved {
            last_click_undo.v = true
          }
        }
        Words => if !words_put_down.v { open_words(x, y) }
        _ =>
          match draft.untracked() {
            Some(m) => {
              draft.set(None)
              if !too_small(m) {
                add_mark(m)
                if !moved {
                  last_click_undo.v = true
                }
              }
            }
            None => ()
          }
      }
    _ => ()
  }
  hand.set(Free)
}

fn step_back(at~ : Option[(Double, Double)] = None) -> Unit {
  if cap_text.untracked() is Some(p) {
    cap_text_action("close", p)
  } else if words_open.untracked().is_some() {
    overlay_disarm_discard()
    words_open.set(None)
  } else if draft.untracked().is_some() {
    overlay_disarm_discard()
    drop_held()
  } else if selected.untracked().is_some() {
    overlay_disarm_discard()
    selected.set(None)
  } else if sel.untracked().is_some() {
    if marks.untracked().length() > 0 && overlay_confirm_discard.untracked() != "right" {
      overlay_arm_discard("right", at=at)
      return
    }
    overlay_disarm_discard()
    signals::start_batch()
    sel.set(None)
    reset_marks()
    tool.set(Move)
    signals::end_batch()
  } else {
    overlay_disarm_discard()
    close_capture()
  }
}

fn hotkey_to_mbui(h : Hotkey) -> Option[(Int, Int)] {
  if h.vk == 0 {
    return None
  }
  let mut mods = 0
  if (h.mods & 4) != 0 {
    mods = mods | ui::mod_shift_key
  }
  if (h.mods & 2) != 0 {
    mods = mods | ui::mod_ctrl
  }
  if (h.mods & 1) != 0 {
    mods = mods | ui::mod_alt
  }
  if (h.mods & 8) != 0 {
    mods = mods | ui::mod_cmd
  }
  let code = match h.vk {
    0x0D => ui::key_code_enter
    0x20 => ui::key_space
    0x09 => ui::key_tab
    0x24 => ui::key_code_home
    0x23 => ui::key_code_end
    0x21 => ui::key_code_page_up
    0x22 => ui::key_code_page_down
    v if v >= 0x41 && v <= 0x5A => 1000 + (v - 0x41 + 97)
    v if v >= 0x30 && v <= 0x39 => 1000 + v
    v if v >= 0x70 && v <= 0x7B => 100 + (v - 0x70)
    _ => return None
  }
  Some((code, mods))
}

fn overlay_keys(confirm : Hotkey) -> view::Keymap {
  let k = fn(code : Int, action : String, mods : Int) -> view::Binding {
    view::Binding::{ keys: [view::Stroke::{ code, mods }], action, when: view::KeyWhen::Always }
  }
  let ch = fn(c : Char, action : String, mods : Int) { k(ui::key_of_char(c), action, mods) }
  let ctrl = shortcut_mod()
  let shift = ui::mod_shift_key
  let list : Array[view::Binding] = []
  match hotkey_to_mbui(confirm) {
    Some((code, mods)) => list.push(k(code, "copy", mods))
    None => ()
  }
  let rest : Array[view::Binding] = [
    k(ui::key_escape, "close", 0),
    k(ui::key_code_delete, "delete", 0),
    ch('v', "select", 0),
    k(ui::key_code_backspace, "delete", 0),
    k(ui::key_code_enter, "copy", 0),
    ch('c', "copy", ctrl),
    k(ui::key_code_copy, "copy", ctrl),
    ch('s', "save", ctrl),
    ch('t', "pin", ctrl),
    ch('o', "ocr", ctrl),
    ch('l', "long", ctrl),
    ch('r', "record", ctrl),
    ch('z', "undo", ctrl),
    ch('y', "redo", ctrl),
    ch('z', "redo", ctrl | shift),
    ch('c', "copy-color", 0),
    ch('b', "beautify", 0),
    ch('a', "whole", ctrl),
    k(ui::key_code_select_all, "whole", ctrl),
    k(ui::key_code_left, "left", 0),
    k(ui::key_code_right, "right", 0),
    k(ui::key_code_up, "up", 0),
    k(ui::key_code_down, "down", 0),
    k(ui::key_code_left, "left10", shift),
    k(ui::key_code_right, "right10", shift),
    k(ui::key_code_up, "up10", shift),
    k(ui::key_code_down, "down10", shift),
  ]
  for b in rest {
    list.push(b)
  }
  view::Keymap::new(list)
}

fn overlay_actions(root : view::View) -> Unit {
  let on = fn(name : String, f : () -> Unit) {
    let _ = root.on_action(name, fn(_) {
      if !capturing.untracked() {
        return false
      }
      match cap_text.untracked() {
        Some(p) => {
          cap_text_action(name, p)
          return true
        }
        None => ()
      }
      if words_open.untracked().is_some() && name != "close" {
        return false
      }
      f()
      true
    })
  }
  on("close", fn() {
    if words_open.untracked().is_some() {
      overlay_disarm_discard()
      commit_words()
    } else if selected.untracked().is_some() {
      overlay_disarm_discard()
      selected.set(None)
    } else if tool.untracked() != Move {
      overlay_disarm_discard()
      tool.set(Move)
    } else if marks.untracked().length() > 0 && overlay_confirm_discard.untracked() != "esc" {
      overlay_arm_discard("esc")
    } else {
      overlay_disarm_discard()
      close_capture()
    }
  })
  on("delete", fn() { let _ = delete_selected() })
  on("select", fn() { tool.set(Move) })
  on("copy", copy_out)
  on("save", save_out)
  on("pin", pin_out)
  on("ocr", ocr_out)
  on("long", long_out)
  on("record", rec_out)
  on("undo", fn() { let _ = undo() })
  on("redo", fn() { let _ = redo() })
  on("copy-color", copy_color)
  on("beautify", beauty_toggle)
  on("whole", fn() {
    if marks.untracked().length() == 0 {
      selected.set(None)
      sel.set(Some(Rect::{ x: 0, y: 0, w: mon.v.w, h: mon.v.h }))
    }
  })
  for step in [(1, ""), (10, "10")] {
    let (n, s) = step
    let k = fn(dx : Int, dy : Int) {
      if !nudge_selected(dx.to_double(), dy.to_double()) {
        nudge(dx, dy)
      }
    }
    on("left" + s, fn() { k(-n, 0) })
    on("right" + s, fn() { k(n, 0) })
    on("up" + s, fn() { k(0, -n) })
    on("down" + s, fn() { k(0, n) })
  }
}

fn nudge(dx : Int, dy : Int) -> Unit {
  match sel.untracked() {
    Some(r) => {
      let m = mon.v
      sel.set(Some({ ..r, x: clampi(r.x + dx, 0, m.w - r.w), y: clampi(r.y + dy, 0, m.h - r.h) }))
    }
    None => ()
  }
}

fn copy_color() -> Unit {
  let (x, y) = pointer_px.untracked()
  let c = pixel_at(x.to_int(), y.to_int())
  if c >= 0 {
    hostapi::clipboard_set(hex6(c))
    close_capture()
  }
}

fn hex6(c : Int) -> String {
  let digits = "0123456789ABCDEF"
  let sb = StringBuilder::new()
  sb.write_char('#')
  for i in 0..<6 {
    let v = (c >> ((5 - i) * 4)) & 0xF
    sb.write_char(digits[v].to_int().unsafe_to_char())
  }
  sb.to_string()
}

fn said_shown() -> Unit {
  let t = ps_now_ms()
  log(
    "capture \{mon.v.w}x\{mon.v.h}@\{num(mon_scale.untracked())}: taken \{num(took_ms.v)} ms (\{took_how.v}), handed over +\{num(taken_at.v - asked_at.v)}, seen +\{num(t - asked_at.v)} ms",
  )
}

fn picked_picture() -> Option[pixels::Vector] {
  if tool.get() == Eraser {
    match sel.get() {
      Some(r) => {
        let (px, py) = pointer_px.get()
        if r.contains(px, py) {
          let k = mon_scale.get()
          let rad = eraser_pt(size_now.get()) * k
          return Some(pixels::Vector::{
            w: mon.v.w.to_double(),
            h: mon.v.h.to_double(),
            layers: [
              fill_layer(circle_path(px, py, rad), 0xFFFFFF26L),
              stroke_layer(circle_path(px, py, rad), 0x00000088L, dmax(1.0, k * 2.0)),
              stroke_layer(circle_path(px, py, rad), 0xFFFFFFFFL, dmax(1.0, k)),
            ],
          })
        }
      }
      None => ()
    }
  }
  if hand.get() is Marking && draft.get() is Some(d) && (d.tool == Mosaic || d.tool == Blur) {
    let k = mon_scale.get()
    let (x0, y0) = d.pts[0]
    let (x1, y1) = d.pts[d.pts.length() - 1]
    let (x, y, w, h) = (dmin(x0, x1), dmin(y0, y1), (x1 - x0).abs(), (y1 - y0).abs())
    if w < 1.0 || h < 1.0 {
      return None
    }
    let t = dmax(1.0, k.round())
    return Some(pixels::Vector::{
      w: mon.v.w.to_double(),
      h: mon.v.h.to_double(),
      layers: [
        fill_layer(rect_path(x, y, w, h), 0x2F9BFF14L),
        fill_layer(rect_path(x, y, w, h) + rect_path(x + t, y + t, w - t * 2.0, h - t * 2.0), accent, even_odd=true),
      ],
    })
  }
  let m = match hand.get() {
    Dragging(_, _, _, _, _, _, _) => draft.get()
    _ =>
      match selected.get() {
        Some(id) => {
          let mut found : Option[Mark] = None
          for mk in marks.get() {
            if mk.id == id {
              found = Some(mk)
              break
            }
          }
          found
        }
        None => None
      }
  }
  let m = match m {
    Some(_v) => _v
    None => { return None }
  }
  let k = mon_scale.get()
  let layers : Array[pixels::VectorPath] = []
  let handles = mark_handles(m)
  if handles.length() == 0 || m.tool == Mosaic || m.tool == Blur {
    let (x0, y0, x1, y1) = mark_box(m, k)
    let pad = 4.0 * k
    layers.push(stroke_layer(rect_path(x0 - pad, y0 - pad, x1 - x0 + pad * 2.0, y1 - y0 + pad * 2.0), accent, k))
  }
  for h in handles {
    let (_, _, x, y) = h
    layers.push(fill_layer(circle_path(x, y, 5.0 * k), accent))
    layers.push(fill_layer(circle_path(x, y, 3.5 * k), 0xFFFFFFFFL))
  }
  Some(pixels::Vector::{ w: mon.v.w.to_double(), h: mon.v.h.to_double(), layers })
}
