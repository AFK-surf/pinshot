// The part picked, with its marks, as a picture of its own pixels (the monitor's: a 4K screen's part is copied at 4K):
// drawn by the GPU as the overlay draws it (mbui's take_picture: the same nodes, the picture and each mark, at the
// monitor's scale), read back as a PNG. Then copied, saved or pinned; the overlay is out of sight at once, closed once
// the picture is taken.

import "hostapi"
import "pixels"
import "signals"
import "ui"
import "view"

/// What is being done with the picture, while it is taken ("" nothing): no second copy meanwhile.
let exporting : signals::Ref[String] = signals::ref_new("")

/// The part picked drawn as a picture of its own pixels, `done` told its PNG: laid on its background where that is on
/// (beautify.mbt), unless `framed` is false (the words read out of it).
fn picture_of_part(done : (Option[Bytes]) -> Unit, framed~ : Bool = true) -> Unit {
  let r = match sel.untracked() {
    Some(_v) => _v
    None => { return }
  }
  if words_open.untracked().is_some() {
    commit_words()
  }
  let k = mon_scale.untracked()
  let key = frozen_key.untracked()
  let px = dmax(mon.v.w.to_double(), mon.v.h.to_double()).to_int()
  let w = r.w.to_double() / k
  let h = r.h.to_double() / k
  let (mw, mh) = (mon.v.w.to_double() / k, mon.v.h.to_double() / k)
  if framed && beauty_on.untracked() {
    let room = beauty_rooms[beauty.untracked().room]
    ui::take_picture("part", w + 2.0 * room, fn(b) {
      let _ = b.height(view::Live::Is(Some(h + 2.0 * room))).clips(view::Live::Is(true)).lines_up(view::Live::Is(Some(view::Along::Start)))
      let _ = b.box(fn(f) {
        let _ = f.over(view::Live::Is(true))
        beauty_drawn(f, w, h, fn(c) {
          let _ = c.box(fn(s) {
            let _ = s
            .width(view::Live::Is(Some(mw)))
            .height(view::Live::Is(Some(mh)))
            .shrink(view::Live::Is(0.0))
            .offset(view::Live::Is((-r.x.to_double() / k, -r.y.to_double() / k)))
            let _ = s.box(fn(p) { let _ = p.over(view::Live::Is(true)).image(view::Live::Is(Some((key, "", px)))) })
            marks_layer(s, editing=false)
          })
        }, overlay=false)
      })
    }, done, scale=k)
    return
  }
  ui::take_picture("part", w, fn(b) {
    let _ = b.height(view::Live::Is(Some(h))).clips(view::Live::Is(true)).lines_up(view::Live::Is(Some(view::Along::Start)))
    let _ = b.box(fn(s) {
      let _ = s
      .width(view::Live::Is(Some(mw)))
      .height(view::Live::Is(Some(mh)))
      .shrink(view::Live::Is(0.0))
      .offset(view::Live::Is((-r.x.to_double() / k, -r.y.to_double() / k)))
      let _ = s.box(fn(p) { let _ = p.over(view::Live::Is(true)).image(view::Live::Is(Some((key, "", px)))) })
      marks_layer(s, editing=false)
    })
  }, done, scale=k)
}

/// The part copied (as a picture other programs paste: PNG and a bitmap), and kept in the pictures' folder where the
/// settings say so.
fn copy_out() -> Unit {
  if exporting.v != "" || sel.untracked().is_none() {
    return
  }
  exporting.v = "copy"
  shutter()
  let t0 = ps_now_ms()
  match sel.untracked() {
    Some(r) => {
      r_w.v = r.w
      r_h.v = r.h
    }
    None => ()
  }
  ps_cloak(0, 1)
  picture_of_part(fn(png) {
    exporting.v = ""
    match png {
      Some(png) => {
        // (a test run copies into a file, never onto the person's clipboard)
        let test_to = ui::env("PINSHOT_TEST_COPY")
        if test_to != "" {
          let _ = ps_write_file(cstr(test_to), png)
        } else {
          hostapi::clipboard_set_image(png)
        }
        log("copy \{r_w.v}x\{r_h.v}: \{png.length()} bytes in \{num(ps_now_ms() - t0)} ms")
        if settings.untracked().keep_copies {
          let dir = settings.untracked().save_dir
          write_picture_file(file_in(dir, file_name()), png)
        }
      }
      None => ()
    }
    close_capture()
  })
}

fn file_name() -> String {
  let ext = if settings.untracked().save_format == 0 { ".png" } else { ".jpg" }
  "PinShot_" + text_of(ps_stamp()) + ext
}

/// A picture (`png`) written to `path`: as JPEG (quality 92 or 80 per settings) when `path` ends in `.jpg`/`.jpeg`,
/// else lossless PNG.
fn write_picture_file(path : String, png : Bytes) -> Unit {
  let lower = str_to_ascii_lower(path)
  if str_has_suffix(lower, ".jpg") || str_has_suffix(lower, ".jpeg") {
    let q = if settings.untracked().save_format == 2 { 80 } else { 92 }
    // (the system's encoder where it can, platform_win's ps_picture_jpeg: tens of milliseconds, not seconds)
    let native = ps_picture_jpeg(png, q)
    if native.length() > 0 {
      let _ = ps_write_file(cstr(path), native)
      return
    }
    match picture_rgba(png) {
      Some((w, h, px)) => {
        let _ = ps_write_file(cstr(path), pixels::jpeg(w, h, pixels::bytes_to_fixed(px), quality=q))
        trim_soon()
        return
      }
      None => ()
    }
  }
  let _ = ps_write_file(cstr(path), png)
}

/// The part saved: where the settings say to ask, the system's dialog in the pictures' folder; else there at once.
fn save_out() -> Unit {
  if exporting.v != "" || sel.untracked().is_none() {
    return
  }
  exporting.v = "save"
  ps_cloak(0, 1)
  picture_of_part(fn(png) {
    exporting.v = ""
    match png {
      Some(png) => {
        let s = settings.untracked()
        // (the overlay hidden while the system's dialog is up: a dialog is not seen over a cloaked owner)
        let path = if s.ask_where {
          ps_hide(0)
          text_of(ps_save_dialog(-1, cstr(s.save_dir), cstr(file_name())))
        } else {
          file_in(s.save_dir, file_name())
        }
        if path != "" {
          write_picture_file(path, png)
          shutter()
          log("saved \{path}")
          close_capture()
        } else {
          // (the dialog called off: back to the capture as it was)
          let m = mon.v
          ps_place(0, m.x, m.y, m.w, m.h, 1, 1)
          ps_cloak(0, 0)
        }
      }
      None => close_capture()
    }
  })
}

/// The part pinned where it is on the screen.
fn pin_out() -> Unit {
  if exporting.v != "" {
    return
  }
  let r = match sel.untracked() {
    Some(_v) => _v
    None => { return }
  }
  exporting.v = "pin"
  shutter()
  ps_cloak(0, 1)
  let m = mon.v
  picture_of_part(fn(png) {
    exporting.v = ""
    match png {
      Some(png) => open_pin(png, m.x + r.x, m.y + r.y, r.w, r.h)
      None => ()
    }
    close_capture()
  })
}

let r_w : signals::Ref[Int] = signals::ref_new(0)

let r_h : signals::Ref[Int] = signals::ref_new(0)

/// The shutter's sound, where the settings have it.
fn shutter() -> Unit {
  if settings.untracked().sound {
    ps_shutter()
  }
}
