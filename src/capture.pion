import "hostapi"
import "signals"
import "ui"

let mon : signals::Ref[Rect] = signals::ref_new(Rect::{ x: 0, y: 0, w: 0, h: 0 })

let mon_work : signals::Ref[Rect] = signals::ref_new(Rect::{ x: 0, y: 0, w: 0, h: 0 })

let mon_scale : signals::Signal[Double] = signals::signal(1.0)

let frozen_key : signals::Signal[String] = signals::signal("")

let frozen_n : signals::Ref[Int] = signals::ref_new(0)

let windows_on : signals::Signal[Array[Rect]] = signals::signal_ref([])

let capturing : signals::Signal[Bool] = signals::signal(false)

let overlay_seen : signals::Signal[Bool] = signals::signal(false)

let asked_at : signals::Ref[Double] = signals::ref_new(0.0)

let took_ms : signals::Ref[Double] = signals::ref_new(0.0)

let pointer_px : signals::Signal[(Double, Double)] = signals::signal_by((0.0, 0.0), same=fn(a, b) { a.0 == b.0 && a.1 == b.1 })

let sel : signals::Signal[Option[Rect]] = signals::signal_by(None, same=fn(a, b) {
  match (a, b) {
    (None, None) => true
    (Some(x), Some(y)) => x == y
    _ => false
  }
})

enum Hand {
  Free
  Drawing(Double, Double)
  Moving(Double, Double, Rect)
  Sizing(Int, Int, Rect)
  Marking
  Erasing(Array[Mark], Double, Double, Bool)
  Dragging(Double, Double, Mark, Array[Mark], Int, Int, Int)
}

fn hand_is_free(h : Hand) -> Bool {
  match h {
    Free => true
    _ => false
  }
}

let hand : signals::Signal[Hand] = signals::signal_ref(Free)

fn window_under() -> Option[Rect] {
  if sel.get().is_some() {
    return None
  }
  let (x, y) = pointer_px.get()
  window_at(x, y)
}

fn window_at(x : Double, y : Double) -> Option[Rect] {
  let full : Rect = Rect::{ x: 0, y: 0, w: mon.v.w, h: mon.v.h }
  let mut found : Option[Rect] = None
  let ws = windows_on.get()
  let mut i = 0
  while i < ws.length() {
    let r = ws[i]
    if r.contains(x, y) {
      found = r.within(full.w, full.h)
      let mut j = i + 1
      while j < ws.length() && inside(ws[j], r) {
        let c = ws[j]
        let smaller = match found {
          Some(f) => c.w * c.h < f.w * f.h
          None => false
        }
        if smaller && c.contains(x, y) && ps_window_shows(i, j, x.to_int(), y.to_int()) == 1 {
          found = c.within(full.w, full.h)
        }
        j += 1
      }
      break
    }
    i += 1
  }
  match found {
    Some(_) => found
    None => Some(full)
  }
}

fn inside(c : Rect, r : Rect) -> Bool {
  c.x >= r.x && c.y >= r.y && c.right() <= r.right() && c.bottom() <= r.bottom()
}

fn pixel_at(x : Int, y : Int) -> Int {
  ps_pixel(x, y)
}

fn parse_windows(s : String) -> Array[Rect] {
  let out : Array[Rect] = []
  for line in s.split("\n") {
    let segs = line.split(";")
    let n = if segs.length() > 0 { numbers_of(segs[0]) } else { [] }
    if n.length() == 4 {
      out.push(Rect::{ x: n[0].to_int(), y: n[1].to_int(), w: n[2].to_int(), h: n[3].to_int() })
    }
  }
  out
}

fn prepare_capture(
  x : Int,
  y : Int,
  w : Int,
  h : Int,
  dpi : Double,
  wx~ : Int = 0,
  wy~ : Int = 0,
  ww~ : Int = 0,
  wh~ : Int = 0,
) -> Unit {
  let was = frozen_key.untracked()
  cap_text_drop()
  mon.v = Rect::{ x, y, w, h }
  mon_work.v = if ww > 0 && wh > 0 { Rect::{ x: wx, y: wy, w: ww, h: wh } } else { Rect::{ x: 0, y: 0, w, h } }
  signals::start_batch()
  mon_scale.set(dmax(1.0, dpi / 96.0))
  reset_marks()
  sel.set(None)
  hand.set(Free)
  tool.set(Move)
  beauty_on.set(false)
  words_open.set(None)
  let p = numbers_of(text_of(ps_pointer()))
  if p.length() == 2 {
    pointer_px.set((p[0] - x.to_double(), p[1] - y.to_double()))
  }
  frozen_key.set("")
  overlay_seen.set(false)
  capturing.set(true)
  signals::end_batch()
  if was != "" {
    ui::forget_image(was)
  }
  ps_capture_open(if warming.v { 2 } else { 1 })
  ps_cloak(0, 1)
  ps_place(0, x, y, w, h, 1, if warming.v { 0 } else { 1 })
}

fn capture_taken() -> Unit {
  let said = text_of(ps_capture_info())
  let info = numbers_of(said)
  let bytes = ps_capture_take()
  if info.length() < 6 || bytes.length() == 0 {
    close_capture()
    return
  }
  took_ms.v = info[5]
  let parts = said.split(",")
  took_how.v = if parts.length() > 0 { parts[parts.length() - 1] } else { "" }
  taken_at.v = ps_now_ms()
  windows_on.set(parse_windows(text_of(ps_windows())))
  frozen_n.v += 1
  let key = "mem:frozen/\{frozen_n.v}"
  ui::add_image(key, bytes)
  frozen_key.set(key)
}

let took_how : signals::Ref[String] = signals::ref_new("")

let taken_at : signals::Ref[Double] = signals::ref_new(0.0)

fn close_capture() -> Unit {
  if !capturing.untracked() {
    return
  }
  if warming.v {
    log("warm-up: done")
  }
  ps_capture_open(0)
  warming.v = false
  ps_cloak(0, 1)
  ps_place(0, mon.v.x, mon.v.y, 16, 16, 0, 0)
  if hostapi::platform() == 0 {
    ps_hide(0)
  } else {
    match overlay_root.v {
      Some(r) => {
        let _ = r.at_moment(r.cause_at() + 120.0, fn() {
          if !capturing.untracked() {
            ps_hide(0)
            trim_soon()
          }
        }, later=true)
      }
      None => ps_hide(0)
    }
  }
  let key = frozen_key.untracked()
  cap_text_drop()
  signals::start_batch()
  overlay_disarm_discard()
  capturing.set(false)
  overlay_seen.set(false)
  sel.set(None)
  hand.set(Free)
  reset_marks()
  frozen_key.set("")
  beauty_on.set(false)
  signals::end_batch()
  wallpaper_let_go()
  mean_cache_clear()
  ps_capture_release()
  windows_on.set([])
  if key != "" {
    ui::forget_image(key)
  }
  trim_soon()
}

fn trim_soon() -> Unit {
  if hostapi::platform() == 0 { return }
  ps_gpu_flush()
}
