import "signals"
import "ui"
import "view"

let words_open : signals::Signal[Option[(Double, Double)]] = signals::signal_by(None, same=fn(a, b) {
  match (a, b) {
    (None, None) => true
    (Some((ax, ay)), Some((bx, by))) => ax == bx && ay == by
    _ => false
  }
})

let words_field : ui::Field = ui::Field::new()

let words_typed : signals::Signal[String] = signals::signal("")

fn open_words(x : Double, y : Double) -> Unit {
  words_field.set("")
  words_typed.set("")
  let size = words_pt(size_now.untracked()) * mon_scale.untracked()
  words_open.set(Some((x, y - size * 0.65)))
}

fn commit_words() -> Unit {
  match words_open.untracked() {
    Some(at) => {
      let text = words_field.text().trim()
      words_open.set(None)
      if text != "" {
        let m = new_mark(Words, [at])
        add_mark({ ..m, words: text })
      }
    }
    None => ()
  }
}

fn words_editor(layer : view::View) -> Unit {
  layer.show(fn() { words_open.get().is_some() }, fn(b) {
    let _ = b.over(view::Live::Is(true)).presses(view::Live::Is(true)).lines_up(view::Live::Is(Some(view::Along::Start)))
    let _ = b.box(fn(f) {
      let k = signals::untracked(fn() { mon_scale.get() })
      let _ = f
      .offset(view::Live::By(fn() {
        match words_open.get() {
          Some((x, y)) => (x / k - 3.0, y / k - 2.0)
          None => (0.0, 0.0)
        }
      }))
      .width(view::Live::By(fn() {
        let size = words_pt(size_now.get())
        let mut longest = 0
        for l in words_typed.get().split("\n") {
          let n = str_chars(l).length()
          if n > longest { longest = n }
        }
        Some(dmax(120.0, longest.to_double() * size * 1.05 + size * 2.0))
      }))
      .padding(view::Live::Is((4.0, 2.0, 4.0, 2.0)))
      .ground(view::Live::Is(0x0000004DL))
      .edge(view::Live::Is((1.0, 0xFFFFFFB3L)))
      .radius(view::Live::Is(3.0))
      let size = signals::untracked(fn() { words_pt(size_now.get()) })
      let color = signals::untracked(fn() { color_now.get() })
      let node = ui::field(
        f,
        words_field,
        placeholder=tr("输入文字"),
        font_size=size,
        line=(size * 1.3).round(),
        max_lines=12,
        color=color,
        placeholder_color=0xFFFFFF99L,
        caret_color=color,
        enter_sends=false,
        edited=fn(t) { words_typed.set(t) },
      )
      ignore(node)
      words_field.focus()
    })
  }, at_once=true)
}
