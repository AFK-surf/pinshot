import "hostapi"
import "json"
import "signals"
import "ui"
import "view"

fn download_base() -> String {
  let here = ui::env("PINSHOT_UPDATE_URL")
  if test_run() && here != "" {
    here
  } else {
    "https://pin-shot.pages.dev/dl/"
  }
}

fn on_mac() -> Bool {
  hostapi::platform() == 0
}

// (what a release is downloaded as here: the Windows executable, or on macOS the zip of PinShot.app)
fn release_file() -> String {
  if on_mac() {
    "PinShot-mac.zip"
  } else {
    "pinshot.exe"
  }
}

fn test_run() -> Bool {
  ui::env("PINSHOT_TEST") != ""
}

fn update_now_test() -> Bool {
  test_run() && ui::env("PINSHOT_TEST_UPDATE_NOW") != ""
}

let site_url : String = "https://pin-shot.pages.dev"

#derive(Eq)
enum Update {
  Unasked
  Checking
  Latest
  Found(String, Bool)
  Fetching(String, Int)
  Ready(String)
  Installing
  Failed(String)
}

let update : signals::Signal[Update] = signals::signal_by(Update::Unasked, same=fn(a, b) { a == b })

#derive(Eq)
struct Release {
  version : String
  setup_sha : String
  exe_sha : String
}

fn plain_version(v : String) -> Bool {
  let parts = v.split(".")
  if parts.length() < 2 || parts.length() > 4 {
    return false
  }
  for p in parts {
    if p.length() == 0 || p.length() > 9 {
      return false
    }
    let mut i = 0
    while i < p.length() {
      let c = p.code_unit_at(i)
      if c < 48 || c > 57 {
        return false
      }
      i += 1
    }
  }
  true
}

fn plain_sha(h : String) -> Bool {
  if h.length() != 64 {
    return false
  }
  let mut i = 0
  while i < h.length() {
    let c = h.code_unit_at(i)
    if !((c >= 48 && c <= 57) || (c >= 97 && c <= 102)) {
      return false
    }
    i += 1
  }
  true
}

let release : signals::Ref[Option[Release]] = signals::ref_new(None)

let update_file : signals::Ref[String] = signals::ref_new("")

let update_asked : signals::Ref[Bool] = signals::ref_new(false)

let ready_at : signals::Ref[Double] = signals::ref_new(0.0)

let ready_noted : signals::Ref[Bool] = signals::ref_new(false)

let last_tried : signals::Ref[Double] = signals::ref_new(0.0)

let install_kind : signals::Ref[Int] = signals::ref_new(-1)

fn update_kind() -> Int {
  if install_kind.v < 0 {
    install_kind.v = ps_install_kind()
  }
  install_kind.v
}

fn updates_here() -> Bool {
  let k = update_kind()
  k != 2 && k != 3
}

let day_s : Double = 86400.0

fn update_state_path() -> String {
  text_of(ps_data_dir()) + (if on_mac() { "/update.json" } else { "\\update.json" })
}

fn last_checked() -> Double {
  match json_of(text_of(ps_read_file(cstr(update_state_path())))) {
    Some(json::Json::Object(o)) => jnum(o, "checked", 0.0)
    _ => 0.0
  }
}

fn set_last_checked(at : Double) -> Unit {
  let o : Map[String, json::Json] = Map::new()
  o["checked"] = json_num(at.floor())
  let _ = ps_write_file(cstr(update_state_path()), utf8_encode(json_stringify(json_obj_map(o))))
}

fn version_parts(v : String) -> Array[Int] {
  let out : Array[Int] = []
  for p in trim_ws(v).split(".") {
    out.push(parse_int_or(p, 0))
  }
  out
}

fn newer(a : String, b : String) -> Bool {
  let x = version_parts(a)
  let y = version_parts(b)
  let n = if x.length() > y.length() { x.length() } else { y.length() }
  for i in 0..<n {
    let p = if i < x.length() { x[i] } else { 0 }
    let q = if i < y.length() { y[i] } else { 0 }
    if p != q {
      return p > q
    }
  }
  false
}

fn agent() -> Bytes {
  cstr("PinShot/" + app_version + (if on_mac() { " (macOS)" } else { " (Windows)" }))
}

fn update_busy() -> Bool {
  match update.untracked() {
    Checking | Fetching(_, _) | Installing => true
    _ => false
  }
}

fn handle_install_cli() -> Bool {
  ps_install_cli(cstr(app_version)) != 0
}

fn start_updates(updated : Bool, installed~ : Bool = false) -> Unit {
  ps_install_sync_meta(cstr(app_version))
  if installed {
    log("installed: now \{app_version}")
  }
  if !updates_here() || (test_run() && ui::env("PINSHOT_UPDATE_URL") == "") {
    return
  }
  ps_update_cleanup()
  if updated {
    log("update: now \{app_version}")
    ps_tray_note(cstr(tr("PinShot 已更新到 ") + app_version), cstr(tr("点这里打开设置。")))
  }
  update_ticks_now()
}

fn update_ticks_now() -> Unit {
  if !updates_here() || (test_run() && ui::env("PINSHOT_UPDATE_URL") == "") {
    return
  }
  if settings.untracked().auto_update || update_now_test() {
    ps_update_ticks(if update_now_test() { 2000 } else { 60 * 1000 }, if update_now_test() { 3000 } else { 10 * 60 * 1000 })
  } else {
    ps_update_ticks(0, 0)
  }
}

fn update_tick() -> Unit {
  if !(settings.untracked().auto_update || update_now_test()) || update_busy() {
    return
  }
  match update.untracked() {
    Ready(_) => install_when_idle()
    Found(_, false) => download_update()
    _ => {
      let now = ps_epoch_s()
      let last = last_checked()
      let due = now - last >= day_s || last > now + 60.0
      if due && now - last_tried.v >= 3600.0 {
        check_update(false)
      }
    }
  }
}

fn check_update(asked : Bool) -> Unit {
  if !updates_here() || update_busy() {
    return
  }
  if update.untracked() is Ready(_) {
    return
  }
  update_asked.v = asked
  last_tried.v = ps_epoch_s()
  if ps_fetch(cstr(download_base() + "latest.json"), cstr(""), cstr(""), agent()) == 1 {
    update.set(Checking)
  } else {
    update.set(Failed("正在下载，请稍后再试"))
  }
}

fn update_told(what : String, o : json::JsonObject, body : Option[Bytes]) -> Unit {
  let ok = jbool(o, "ok", false)
  match what {
    "fetching" => {
      let v = match update.untracked() {
        Update::Fetching(v, _) => v
        _ => return
      }
      let total = jnum(o, "total", 0.0)
      let pct = if total > 0.0 { (jnum(o, "got", 0.0) * 100.0 / total).to_int() } else { -1 }
      update.set(Update::Fetching(v, pct))
    }
    "fetched" =>
      match update.untracked() {
        Update::Checking => if ok { latest_read(body) } else { fetch_failed(o, "检查更新失败") }
        Update::Fetching(v, _) =>
          if ok {
            log("update: \{v} downloaded")
            ready_at.v = ps_epoch_s()
            ready_noted.v = false
            update.set(Update::Ready(v))
            if update_asked.v {
              install_update()
            } else {
              install_when_idle()
            }
          } else {
            fetch_failed(o, "下载更新失败")
          }
        _ => ()
      }
    "setup-ended" =>
      match update.untracked() {
        Update::Installing => {
          let code = jnum(o, "code", -1.0).to_int()
          log("update: the installer ended (\{code}) and this run is still here")
          update.set(Update::Failed("无法安装更新"))
        }
        _ => ()
      }
    _ => ()
  }
}

fn fetch_failed(o : json::JsonObject, head : String) -> Unit {
  let why = jstr(o, "error", "")
  log("update: \{head}: \{why}")
  update.set(
    Update::Failed(
      match why {
        "checksum" => "下载的文件校验失败"
        "cannot write" => "无法写入程序所在的文件夹"
        s if str_has_prefix(s, "http ") => head
        _ => head + "，请检查网络"
      },
    ),
  )
}

fn latest_read(body : Option[Bytes]) -> Unit {
  let text = match body {
    Some(b) => text_of(b)
    None => ""
  }
  let o = match json_of(text) {
    Some(json::Json::Object(o)) => o
    _ => {
      update.set(Update::Failed("检查更新失败"))
      return
    }
  }
  let s = fn(k : String) { str_to_ascii_lower(trim_ws(jstr(o, k, ""))) }
  let version = s("version")
  if !plain_version(version) {
    log("update: latest.json names no plain version")
    update.set(Failed("检查更新失败"))
    return
  }
  set_last_checked(ps_epoch_s())
  if !newer(version, app_version) {
    log("update: \{app_version} is the latest")
    update.set(Latest)
    return
  }
  // (on macOS the release's zip, named twice where Windows names its setup and its executable: signed as those are)
  let r = if on_mac() {
    Release::{ version, setup_sha: s("mac_sha256"), exe_sha: s("mac_sha256") }
  } else {
    Release::{ version, setup_sha: s("setup_sha256"), exe_sha: s("exe_sha256") }
  }
  let signature = s(if on_mac() { "mac_signature" } else { "signature" })
  release.v = Some(r)
  let by_hand = !(plain_sha(r.setup_sha) &&
    plain_sha(r.exe_sha) &&
    ps_release_signed(cstr(version), cstr(r.setup_sha), cstr(r.exe_sha), cstr(signature)) == 1)
  log("update: \{version} found\{if by_hand { " (not signed: by hand)" } else { "" }}")
  update.set(Found(version, by_hand))
  if !update_asked.v {
    if by_hand {
      ps_tray_note(cstr(tr("PinShot 有新版本：") + version), cstr(tr("点这里打开设置更新。")))
    } else {
      download_update()
    }
  }
}

fn download_update() -> Unit {
  let r = match release.v {
    Some(_v) => _v
    None => { return }
  }
  let url = download_base() + "v\{r.version}/" + release_file()
  let path = text_of(ps_update_path(cstr(release_file())))
  update_file.v = path
  if path != "" &&
    ps_fetch(cstr(url), cstr(path), cstr(r.exe_sha), agent()) == 1 {
    log("update: downloading \{url}")
    update.set(Fetching(r.version, -1))
  } else {
    update.set(Failed("下载更新失败"))
  }
}

fn install_update() -> Unit {
  guard update.untracked() is Ready(v) else { return }
  let r = match release.v {
    Some(_v) => _v
    None => { return }
  }
  log("update: installing \{v}")
  update.set(Installing)
  let done = ps_swap_exe(cstr(update_file.v), cstr(r.exe_sha))
  if done == -1 {
    log("update: \{v} is not the file signed")
    update.set(Failed("下载的文件校验失败"))
  } else if done != 1 {
    log("update: could not install \{v}")
    update.set(Failed("无法安装更新"))
  }
}

fn install_when_idle() -> Unit {
  guard update.untracked() is Ready(v) else { return }
  if !capturing.untracked() && pins.length() == 0 && settings_wid.v == 0 && long_wid.v == 0 && rec_wid.v == 0 && (update_now_test() || ps_idle_ms() >= 120 * 1000) {
    install_update()
    return
  }
  log(
    "update: \{v} waits (capture \{capturing.untracked()}, pins \{pins.length()}, settings \{settings_wid.v}, idle \{ps_idle_ms()} ms)",
  )
  if !ready_noted.v && ps_epoch_s() - ready_at.v >= day_s {
    ready_noted.v = true
    ps_tray_note(
      cstr(tr("PinShot ") + v + tr(" 已下载")),
      cstr(tr("关闭全部贴图后会自动更新；也可以点这里在设置里立即更新。")),
    )
  }
}

fn update_button_words() -> String {
  match update.get() {
    Unasked | Latest | Failed(_) => tr("检查更新")
    Checking => tr("正在检查…")
    Found(_, true) => tr("前往下载")
    Found(_, false) => tr("立即更新")
    Fetching(_, p) => if p >= 0 { tr("下载中 ") + p.to_string() + "%" } else { tr("下载中…") }
    Ready(_) => if pins.length() > 0 { tr("关闭贴图并更新") } else { tr("重启并更新") }
    Installing => tr("正在更新…")
  }
}

fn update_button_pressed() -> Unit {
  match update.untracked() {
    Unasked | Latest | Failed(_) => check_update(true)
    Found(_, true) => ps_open_url(cstr(site_url))
    Found(_, false) => {
      update_asked.v = true
      download_update()
    }
    Fetching(_, _) => update_asked.v = true
    Ready(_) => install_update()
    Checking | Installing => ()
  }
}

fn update_note() -> String {
  let ver = "PinShot " + app_version
  if update_kind() == 3 {
    return ver
  }
  if !updates_here() {
    return ver + " · " + tr("通过 Microsoft Store 更新")
  }
  match update.get() {
    Unasked => ver
    Checking => ver + " · " + tr("正在检查…")
    Latest => ver + " · " + tr("已是最新版本")
    Found(v, _) | Fetching(v, _) => ver + " · " + tr("发现新版本 ") + v
    Ready(v) => ver + " · " + tr("新版本 ") + v + tr(" 已下载")
    Installing => ver + " · " + tr("正在更新…")
    Failed(why) => ver + " · " + tr(why)
  }
}

fn update_notes_url() -> String {
  match release.v {
    Some(r) => "https://github.com/AFK-surf/pinshot/releases/tag/v" + r.version
    None => site_url
  }
}

fn update_settings(g : view::View) -> Unit {
  set_row(g, "版本", fn(r) {
    if updates_here() {
      small_button(r, fn() { tr("更新内容") }, fn() { ps_open_url(cstr(update_notes_url())) }, shown=fn() {
        match update.get() {
          Found(_, _) | Fetching(_, _) | Ready(_) => true
          _ => false
        }
      })
      small_button(r, update_button_words, update_button_pressed, min_width=fn() {
        Some(if english.get() { 128.0 } else { 88.0 })
      })
    }
  }, note=update_note, note_ink=fn() {
    if update.get() is Failed(_) {
      0xE5A545FFL
    } else {
      set_muted
    }
  })
  if updates_here() {
    set_row(g, "自动更新", fn(r) {
      switch(r, fn() { settings.get().auto_update }, fn(on) {
        change_settings(fn(s) { Settings::{ ..s, auto_update: on } })
        update_ticks_now()
        if on {
          update_tick()
        }
      })
    }, note=fn() { tr("每天检查一次，空闲时在后台下载并安装") }, note_ink=fn() { set_muted })
  }
}
