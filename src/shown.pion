import "motion"
import "signals"
import "ui"
import "view"

let shown_spring : motion::Spec = motion::tween(140.0, ease=ui::Ease::Out)

let shown_x : motion::Way = motion::Way::new(0.0)

let shown_y : motion::Way = motion::Way::new(0.0)

let shown_w : motion::Way = motion::Way::new(0.0)

let shown_h : motion::Way = motion::Way::new(0.0)

let shown_room : motion::Way = motion::Way::new(0.0)

let beauty_fade : motion::Way = motion::Way::new(1.0)

let shown_had : signals::Ref[Bool] = signals::ref_new(false)

fn shown_follow(stage : view::View) -> Unit {
  stage.reacts(fn() { (clear_part(), beauty_frame()) }, fn(now) {
    let (part, frame) = now
    let at = stage.cause_at()
    match part {
      None => {
        shown_had.v = false
        shown_room.put(0.0)
      }
      Some(r) => {
        let held = match hand.untracked() {
          Drawing(_, _) | Moving(_, _, _) | Sizing(_, _, _) => true
          _ => false
        }
        let at_once = !shown_had.v || held
        for wv in [(shown_x, r.x), (shown_y, r.y), (shown_w, r.w), (shown_h, r.h)] {
          let (way, v) = wv
          if at_once {
            way.put(v.to_double())
          } else {
            way.go(v.to_double(), shown_spring, at=at)
          }
        }
        let room = match frame {
          Some(f) => (r.x - f.x).to_double()
          None => 0.0
        }
        if shown_had.v {
          shown_room.go(room, shown_spring, at=at)
        } else {
          shown_room.put(room)
        }
        shown_had.v = true
      }
    }
  })
}

fn shown_part(n : view::View) -> Option[Rect] {
  if !(clear_part().is_some()) { return None }
  let x = shown_x.shown_on(n).round().to_int()
  let y = shown_y.shown_on(n).round().to_int()
  let w = shown_w.shown_on(n).round().to_int()
  let h = shown_h.shown_on(n).round().to_int()
  Some(Rect::{ x, y, w: if w < 1 { 1 } else { w }, h: if h < 1 { 1 } else { h } })
}

fn shown_frame(n : view::View) -> Option[Rect] {
  let r = match shown_part(n) {
    Some(_v) => _v
    None => { return None }
  }
  let p = shown_room.shown_on(n).round().to_int()
  if p <= 0 {
    return None
  }
  Some(Rect::{ x: r.x - p, y: r.y - p, w: r.w + 2 * p, h: r.h + 2 * p })
}

fn shown_whole(n : view::View) -> Option[Rect] {
  match shown_frame(n) {
    Some(f) => Some(f)
    None => shown_part(n)
  }
}
