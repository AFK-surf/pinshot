import "hostapi"
import "kit"
import "motion"
import "pixels"
import "signals"
import "ui"
import "view"

let bar_button : Double = 32.0

let bar_pad : Double = 4.0

let bar_corner : Double = 15.0

let bar_btn_corner : Double = 11.0

let style_corner : Double = 13.0

let style_btn_corner : Double = 9.0

let bar_rule : Double = 7.0

let bar_gap : Double = 3.0

let shape_tool : signals::Signal[Tool] = signals::signal_by(Box, same=fn(a, b) { a == b })

let line_tool : signals::Signal[Tool] = signals::signal_by(Arrow, same=fn(a, b) { a == b })

let mosaic_tool : signals::Signal[Tool] = signals::signal_by(Mosaic, same=fn(a, b) { a == b })

fn is_shape_tool(t : Tool) -> Bool {
  match t {
    Box | Oval | Focus => true
    _ => false
  }
}

fn is_line_tool(t : Tool) -> Bool {
  match t {
    Arrow | Line => true
    _ => false
  }
}

fn is_pen_tool(t : Tool) -> Bool {
  match t {
    Pen | Eraser => true
    _ => false
  }
}

fn is_mosaic_tool(t : Tool) -> Bool {
  match t {
    Mosaic | MosaicBrush | Blur => true
    _ => false
  }
}

fn tool_glyph(t : Tool) -> String {
  match t {
    Move => "select"
    Box => "box"
    Oval => "oval"
    Focus => "focus"
    Arrow => "arrow"
    Line => "line"
    Pen => "pen"
    Eraser => "eraser"
    Mosaic => "mosaic"
    MosaicBrush => "mosaic-brush"
    Blur => "blur"
    Number => "number"
    Words => "words"
  }
}

fn tool_label(t : Tool) -> String {
  match t {
    Move => "选择（V）"
    Box => "矩形"
    Oval => "椭圆"
    Focus => "聚焦（框出重点，其余变暗）"
    Arrow => "箭头（按住 Shift 水平、垂直或 45°）"
    Line => "直线（按住 Shift 水平、垂直或 45°）"
    Pen => "画笔"
    Eraser => "橡皮擦（涂抹擦除画笔）"
    Mosaic => "像素马赛克（框选打码）"
    MosaicBrush => "涂抹马赛克（按住涂抹打码）"
    Blur => "模糊遮罩（平滑柔化打码）"
    Number => "序号"
    Words => "文字"
  }
}

let bar_rest_tools : Array[Tool] = [Number, Words]

let shape_variants : Array[Tool] = [Box, Oval, Focus]

let line_variants : Array[Tool] = [Arrow, Line]

let pen_variants : Array[Tool] = [Pen, Eraser]

let mosaic_variants : Array[Tool] = [Mosaic, MosaicBrush, Blur]

fn bar_width() -> Double {
  let n = 14.0 + (if long_shot_here() { 1.0 } else { 0.0 }) + (if rec_here() { 1.0 } else { 0.0 })
  bar_pad * 2.0 + bar_button * n + bar_rule * 2.0 + bar_gap * (n + 1.0)
}

let bar_height : Double = 40.0

let style_height : Double = 36.0

let bar_sub_max_h : Double = (style_height + 4.0) * 2.0

fn bar_anchor(n : view::View) -> (Double, Double, Bool) {
  let k = mon_scale.get()
  let (wx0, wy0, wx1, wy1) = work_pt()
  if !(sel.get().is_some()) { return (0.0, 0.0, false) }
  match shown_whole(n) {
    Some(r) => {
      let rx1 = r.right().to_double() / k
      let ry0 = r.y.to_double() / k
      let ry1 = r.bottom().to_double() / k
      let w = bar_width()
      let x = clamp(rx1 - w, wx0 + 8.0, dmax(wx0 + 8.0, wx1 - w - 8.0))
      let my = if ry1 + 8.0 + bar_height <= wy1 - 4.0 {
        ry1 + 8.0
      } else if ry0 - 8.0 - bar_height >= wy0 + 4.0 {
        ry0 - 8.0 - bar_height
      } else {
        clamp(ry1 - bar_height - 8.0, wy0 + 8.0, dmax(wy0 + 8.0, wy1 - bar_height - 8.0))
      }
      let open_sub = (if styling() { style_height + 4.0 } else { 0.0 }) +
        (if beauty_on.get() { style_height + 4.0 } else { 0.0 })
      let need = dmax(style_height + 4.0, open_sub)
      let no_room_below = my + bar_height + need > wy1 - 4.0
      let bar_is_above_sel = my + bar_height <= ry0
      let up = (no_room_below || bar_is_above_sel) && my >= wy0 + need + 4.0
      (x, my, up)
    }
    None => (0.0, 0.0, false)
  }
}

fn bar_place(n : view::View) -> (Double, Double) {
  let (x, my, up) = bar_anchor(n)
  (x, if up { my - bar_sub_max_h } else { my })
}

fn pick_tool(which : Tool) -> Unit {
  if words_open.untracked().is_some() {
    commit_words()
  }
  tool.set(if tool.untracked() == which { Move } else { which })
}

fn main_tool_slot() -> Int {
  let t = tool.get()
  if t == Move {
    0
  } else if is_shape_tool(t) {
    1
  } else if is_line_tool(t) {
    2
  } else if is_pen_tool(t) {
    3
  } else if is_mosaic_tool(t) {
    4
  } else if t == Number {
    5
  } else if t == Words {
    6
  } else {
    -1
  }
}

let toolbar_main_view : signals::Ref[Option[view::View]] = signals::ref_new(None)

fn toolbar_main_rect() -> Option[(Double, Double, Double, Double)] {
  match toolbar_main_view.v {
    Some(v) if v.alive() => {
      let (x, y, w, h) = v.laid_window_now()
      if w > 20.0 && h > 10.0 {
        Some((x, y, w, h))
      } else {
        None
      }
    }
    _ => None
  }
}

fn bar_shown() -> Bool {
  sel.get().is_some() &&
  (match hand.get() {
    Drawing(_, _) | Moving(_, _, _) | Sizing(_, _, _) => false
    _ => true
  })
}

fn toolbar(stage : view::View) -> Unit {
  let _ = stage.box(fn(o) {
    let _ = o.over(view::Live::Is(true)).lines_up(view::Live::Is(Some(view::Along::Start)))
    let _ = o.box(fn(col) {
      let bar_in = motion::NodeWay::new(if signals::untracked(bar_shown) { 1.0 } else { 0.0 })
      col.reacts(bar_shown, at_start=false, fn(on) {
        if on {
          bar_in.go_from(col, 0.0, 1.0, motion::tween(130.0, ease=ui::Ease::Out))
        } else {
          bar_in.put(0.0)
        }
      })
      let is_up = fn() { bar_anchor(col).2 }
      let _ = col
      .gap(view::Live::Is(4.0))
      .lines_up(view::Live::Is(Some(view::Along::Start)))
      .height(view::Live::By(fn() { if is_up() { Some(bar_height + bar_sub_max_h) } else { None } }))
      .lies_along(view::Live::By(fn() { if is_up() { view::Lies::End } else { view::Lies::Start } }))
      .offset(view::Live::By(fn() { bar_place(col) }))
      .alpha(view::Live::By(fn() { bar_in.shown(col) }))
      .drawn_off(view::Live::By(fn() { (0.0, 4.0 * (1.0 - bar_in.shown(col))) }))
      .laid_nowhere(view::Live::By(fn() { !bar_shown() }))
      col.show(fn() { is_up() && beauty_on.get() }, leave=115.0, fn(slot) {
        dropdown_unfold(slot, style_height, beauty_row, upward=true)
      })
      col.show(fn() { is_up() && styling() }, leave=115.0, fn(slot) {
        dropdown_unfold(slot, style_height, style_row, upward=true)
      })
      let _ = col.box(fn(bar) {
        toolbar_main_view.v = Some(bar)
        let _ = bar.owns(fn() { toolbar_main_view.v = None })
        bar_panel(bar, bar_corner)
        let _ = bar.row(view::Live::Is(true)).gap(view::Live::Is(bar_gap)).width(view::Live::Is(Some(bar_width())))
        let _ = bar.box(fn(tg) {
          let _ = tg.row(view::Live::Is(true)).gap(view::Live::Is(bar_gap)).lines_up(view::Live::Is(Some(view::Along::Middle)))
          let tool_views : Map[Int, view::View] = Map::new()
          sliding_thumb(
            tg,
            main_tool_slot,
            tool_views,
            bar_btn_corner,
            fn() { 0xFFFFFF3DL },
            snap_watch=fn() { if bar_shown() { 1 } else { 0 } },
          )
          tool_button(
            tg,
            "select",
            "选择",
            fn() { tool.get() == Move },
            fn() { pick_tool(Move) },
            keys=fn() { "V" },
            slot_views=Some((0, tool_views)),
          )
          tool_group_button(
            tg,
            fn() {
              let t = tool.get()
              tool_glyph(if is_shape_tool(t) { t } else { shape_tool.get() })
            },
            fn() {
              let t = tool.get()
              tool_label(if is_shape_tool(t) { t } else { shape_tool.get() })
            },
            fn() { is_shape_tool(tool.get()) },
            fn() {
              if words_open.untracked().is_some() {
                commit_words()
              }
              if is_shape_tool(tool.untracked()) {
                tool.set(Move)
              } else {
                tool.set(shape_tool.untracked())
              }
            },
            slot_views=Some((1, tool_views)),
          )
          tool_group_button(
            tg,
            fn() {
              let t = tool.get()
              tool_glyph(if is_line_tool(t) { t } else { line_tool.get() })
            },
            fn() {
              let t = tool.get()
              tool_label(if is_line_tool(t) { t } else { line_tool.get() })
            },
            fn() { is_line_tool(tool.get()) },
            fn() {
              if words_open.untracked().is_some() {
                commit_words()
              }
              if is_line_tool(tool.untracked()) {
                tool.set(Move)
              } else {
                tool.set(line_tool.untracked())
              }
            },
            slot_views=Some((2, tool_views)),
          )
          tool_button(
            tg,
            "pen",
            "画笔",
            fn() { is_pen_tool(tool.get()) },
            fn() {
              if words_open.untracked().is_some() {
                commit_words()
              }
              if is_pen_tool(tool.untracked()) {
                tool.set(Move)
              } else {
                selected.set(None)
                tool.set(Pen)
              }
            },
            slot_views=Some((3, tool_views)),
          )
          tool_group_button(
            tg,
            fn() {
              let t = tool.get()
              tool_glyph(if is_mosaic_tool(t) { t } else { mosaic_tool.get() })
            },
            fn() {
              let t = tool.get()
              tool_label(if is_mosaic_tool(t) { t } else { mosaic_tool.get() })
            },
            fn() { is_mosaic_tool(tool.get()) },
            fn() {
              if words_open.untracked().is_some() {
                commit_words()
              }
              if is_mosaic_tool(tool.untracked()) {
                tool.set(Move)
              } else {
                tool.set(mosaic_tool.untracked())
              }
            },
            slot_views=Some((4, tool_views)),
          )
          for idx, which in bar_rest_tools {
            tool_button(
              tg,
              tool_glyph(which),
              tool_label(which),
              fn() { tool.get() == which },
              fn() { pick_tool(which) },
              slot_views=Some((5 + idx, tool_views)),
            )
          }
        })
        tool_button(bar, "beautify", "美化背景", fn() { beauty_on.get() }, beauty_toggle, keys=fn() { "B" })
        bar_rule_node(bar)
        tool_button(bar, "undo", "撤销", fn() { false }, fn() { let _ = undo() }, dim=fn() {
          let _ = marks.get()
          done_before.v.length() == 0
        }, keys=fn() { "Ctrl+Z" })
        bar_rule_node(bar)
        tool_button(bar, "ocr", "提取文字", fn() { false }, ocr_out, keys=fn() { "Ctrl+O" })
        if long_shot_here() {
          tool_button(bar, "long", "长截图", fn() { false }, long_out, keys=fn() { "Ctrl+L" })
        }
        if rec_here() {
          tool_button(bar, "record", "录屏", fn() { false }, rec_out, keys=fn() { "Ctrl+R" })
        }
        tool_button(bar, "pin", "贴到屏幕", fn() { false }, pin_out, keys=fn() { "Ctrl+T" })
        tool_button(bar, "save", "保存截图", fn() { false }, save_out, keys=fn() { "Ctrl+S" })
        tool_button(bar, "close", "关闭", fn() { false }, close_capture, keys=fn() { "Esc" })
        tool_button(bar, "check", "复制", fn() { false }, copy_out, strong=true, keys=confirm_key_label)
      })
      col.show(fn() { !is_up() && styling() }, leave=115.0, fn(slot) {
        dropdown_unfold(slot, style_height, style_row)
      })
      col.show(fn() { !is_up() && beauty_on.get() }, leave=115.0, fn(slot) {
        dropdown_unfold(slot, style_height, beauty_row)
      })
    })
    bar_tip_node(o)
  })
}

fn bar_panel(b : view::View, rad : Double) -> Unit {
  let _ = b
  .pad(view::Live::Is(bar_pad))
  .radius(view::Live::Is(rad))
  .ground(view::Live::Is(0x18191DF7L))
  .edge(view::Live::Is((1.0, 0xFFFFFF2EL)))
  .shadow(view::Live::Is((18.0, 4.0, 0x00000073L)))
  .lines_up(view::Live::Is(Some(view::Along::Middle)))
  .presses(view::Live::Is(true))
  .cursor(view::Live::Is(Some(view::Cursor::Arrow)))
}

fn bar_rule_node(bar : view::View, shown~ : () -> Bool  = fn() { true }) -> Unit {
  let _ = bar.box(fn(r) {
    let _ = r
    .laid_nowhere(view::Live::By(fn() { !shown() }))
    .width(view::Live::Is(Some(bar_rule)))
    .height(view::Live::Is(Some(20.0)))
    .lies_along(view::Live::Is(view::Lies::Middle))
    .lines_up(view::Live::Is(Some(view::Along::Middle)))
    let _ = r.box(fn(l) { let _ = l.width(view::Live::Is(Some(1.0))).height(view::Live::Is(Some(16.0))).ground(view::Live::Is(0xFFFFFF2EL)) })
  })
}

fn tool_button(
  bar : view::View,
  glyph_name : String,
  label : String,
  on : () -> Bool,
  press : () -> Unit,
  dim~ : () -> Bool  = fn() { false },
  strong~ : Bool = false,
  tip~ : Bool = true,
  tips~ : kit::TipLayer = bar_tips,
  keys~ : () -> String  = fn() { "" },
  slot_views~ : Option[(Int, Map[Int, view::View])] = None,
) -> Unit {
  tool_group_button(bar, fn() { glyph_name }, fn() { label }, on, press, dim=dim, strong=strong, tip=tip, tips=tips, keys=keys, slot_views=slot_views)
}

fn tool_group_button(
  bar : view::View,
  glyph_fn : () -> String,
  label_fn : () -> String,
  on : () -> Bool,
  press : () -> Unit,
  dim~ : () -> Bool  = fn() { false },
  strong~ : Bool = false,
  tip~ : Bool = true,
  tips~ : kit::TipLayer = bar_tips,
  keys~ : () -> String  = fn() { "" },
  slot_views~ : Option[(Int, Map[Int, view::View])] = None,
) -> Unit {
  let _ = bar.box(fn(b) {
    let has_slider = match slot_views {
      Some((idx, views)) => {
        views[idx] = b
        true
      }
      None => false
    }
    let live = fn() { !dim() }
    let hov = smooth_hover(b, live=live, ms=100.0)
    let act = motion::eased_on(b, on, motion::tween(120.0, ease=ui::Ease::Out))
    tactile_press(b, live=live, sink_px=1.0)
    let _ = b
    .width(view::Live::Is(Some(bar_button)))
    .height(view::Live::Is(Some(bar_button)))
    .radius(view::Live::Is(bar_btn_corner))
    .lines_up(view::Live::Is(Some(view::Along::Middle)))
    .lies_along(view::Live::Is(view::Lies::Middle))
    .presses(view::Live::Is(true))
    .cursor(view::Live::By(fn() { if dim() { None } else { Some(view::Cursor::Hand) } }))
    .says(view::Live::By(fn() { Some(view::said(view::Role::Button, label=tr(label_fn()))) }))
    .on_press(fn() {
      if tip {
        tips.dismiss()
      }
      if !dim() {
        press()
      }
    })
    .ground(view::Live::By(fn() {
      if b.pressed() && !dim() {
        0xFFFFFF2CL
      } else if has_slider && on() {
        0L
      } else {
        let rest = mix_rgba(0L, 0xFFFFFF20L, hov())
        if has_slider { rest } else { mix_rgba(rest, 0xFFFFFF3DL, act.shown(b)) }
      }
    }))
    if tip {
      ps_tip_follow(tips, b, label_fn, view::Side::Top, keys=keys)
    }
    let _ = b.box(fn(g) {
      let _ = g
      .width(view::Live::Is(Some(18.0)))
      .height(view::Live::Is(Some(18.0)))
      .picture(view::Live::By(fn() { Some(glyph(glyph_fn())) }))
      .tint(view::Live::By(fn() {
        if dim() {
          0xFFFFFF66L
        } else if strong {
          0x4CC38AFFL
        } else {
          mix_rgba(0xEAECEFFFL, 0xFFFFFFFFL, dmax(act.shown(g), hov() * 0.6))
        }
      }))
    })
  })
}

fn styling() -> Bool {
  tool.get() != Move || selected.get().is_some()
}

fn sub_tool_of(grp : Int, idx : Int) -> Option[Tool] {
  let arr = match grp {
    1 => shape_variants
    2 => line_variants
    3 => pen_variants
    4 => mosaic_variants
    _ => []
  }
  if idx >= 0 && idx < arr.length() {
    Some(arr[idx])
  } else {
    None
  }
}

fn pick_sub_tool(grp : Int, which : Tool) -> Unit {
  if grp == 1 {
    shape_tool.set(which)
    tool.set(which)
  } else if grp == 2 {
    line_tool.set(which)
    tool.set(which)
  } else if grp == 3 {
    selected.set(None)
    tool.set(which)
  } else if grp == 4 {
    mosaic_tool.set(which)
    tool.set(which)
  }
}

fn sub_tool_strip(left_slot : view::View, shown_grp : signals::Signal[Int]) -> Unit {
  let _ = left_slot.box(fn(btns) {
    let _ = btns.row(view::Live::Is(true)).gap(view::Live::Is(bar_gap)).height(view::Live::Is(Some(28.0))).lines_up(view::Live::Is(Some(view::Along::Middle)))
    let views : Map[Int, view::View] = Map::new()
    let active_idx = fn() {
      let g = shown_grp.get()
      let cur = tool.get()
      for i in 0..<3 {
        match sub_tool_of(g, i) {
          Some(t) if t == cur => return i
          _ => ()
        }
      }
      -1
    }
    sliding_thumb(
      btns,
      active_idx,
      views,
      style_btn_corner,
      fn() { 0xFFFFFF3DL },
      snap_watch=fn() { shown_grp.get() * 2 + (if bar_shown() { 1 } else { 0 }) },
    )
    for i in 0..<3 {
      let _ = btns.box(fn(b) {
        views[i] = b
        let has = fn() { sub_tool_of(shown_grp.get(), i).is_some() }
        let is_on = fn() {
          match sub_tool_of(shown_grp.get(), i) {
            Some(w) => tool.get() == w
            None => false
          }
        }
        let hov = smooth_hover(b, live=has, ms=100.0)
        tactile_press(b, live=has, sink_px=1.0)
        let _ = b
        .laid_nowhere(view::Live::By(fn() { !has() }))
        .width(view::Live::Is(Some(28.0)))
        .height(view::Live::Is(Some(28.0)))
        .radius(view::Live::Is(style_btn_corner))
        .lines_up(view::Live::Is(Some(view::Along::Middle)))
        .lies_along(view::Live::Is(view::Lies::Middle))
        .presses(view::Live::By(has))
        .cursor(view::Live::By(fn() { if has() { Some(view::Cursor::Hand) } else { None } }))
        .says(view::Live::By(fn() {
          match sub_tool_of(shown_grp.get(), i) {
            Some(w) => Some(view::said(view::Role::Button, label=tr(tool_label(w))))
            None => None
          }
        }))
        .on_press(fn() {
          let g = shown_grp.untracked()
          match sub_tool_of(g, i) {
            Some(w) => {
              tip_off()
              pick_sub_tool(g, w)
            }
            None => ()
          }
        })
        .ground(view::Live::By(fn() {
          if b.pressed() && has() {
            0xFFFFFF2CL
          } else if is_on() {
            0L
          } else {
            mix_rgba(0L, 0xFFFFFF20L, hov())
          }
        }))
        tip_follows(b, fn() {
          match sub_tool_of(shown_grp.get(), i) {
            Some(w) => tool_label(w)
            None => ""
          }
        }, view::Bottom)
        let _ = b.box(fn(g) {
          let _ = g
          .width(view::Live::Is(Some(17.0)))
          .height(view::Live::Is(Some(17.0)))
          .picture(view::Live::By(fn() {
            match sub_tool_of(shown_grp.get(), i) {
              Some(w) => Some(glyph(tool_glyph(w)))
              None => None
            }
          }))
          .tint(view::Live::By(fn() {
            if is_on() {
              0xFFFFFFFFL
            } else {
              mix_rgba(0xEAECEFFFL, 0xFFFFFFFFL, hov() * 0.6)
            }
          }))
        })
      })
    }
  })
  let _ = left_slot.box(fn(d) {
    let _ = d
    .over_at(view::Live::Is((None, Some(4.0), Some(bar_gap), None)))
    .width(view::Live::Is(Some(bar_rule)))
    .height(view::Live::Is(Some(20.0)))
    .lies_along(view::Live::Is(view::Lies::Middle))
    .lines_up(view::Live::Is(Some(view::Along::Middle)))
    .laid_nowhere(view::Live::By(fn() { shown_grp.get() == 0 }))
    let _ = d.box(fn(l) { let _ = l.width(view::Live::Is(Some(1.0))).height(view::Live::Is(Some(16.0))).ground(view::Live::Is(0xFFFFFF2EL)) })
  })
}

fn style_left_width(grp : Int) -> Double {
  match grp {
    1 | 4 => 3.0 * 28.0 + 2.0 * bar_gap + bar_gap + bar_rule + bar_gap
    2 | 3 => 2.0 * 28.0 + bar_gap + bar_gap + bar_rule + bar_gap
    _ => 0.0
  }
}

fn style_pill_width(grp : Int, has_col : Bool) -> Double {
  let sz_w = 3.0 * 28.0 + 2.0 * bar_gap
  let col_w = if has_col {
    bar_gap + bar_rule + bar_gap + colors.length().to_double() * 28.0 + (colors.length() - 1).to_double() * bar_gap
  } else {
    0.0
  }
  bar_pad * 2.0 + style_left_width(grp) + sz_w + col_w
}

fn style_row(row : view::View) -> Unit {
  let active_grp = fn() -> Int {
    let t = tool.get()
    if is_shape_tool(t) {
      1
    } else if is_line_tool(t) {
      2
    } else if is_pen_tool(t) {
      3
    } else if is_mosaic_tool(t) {
      4
    } else {
      0
    }
  }
  let has_color = fn() -> Bool {
    let t = tool.get()
    if t != Move {
      !is_mosaic_tool(t) && t != Focus && t != Eraser
    } else {
      match selected.get() {
        Some(id) =>
          match mark_index(id) {
            Some(i) => {
              let mt = marks.get()[i].tool
              !is_mosaic_tool(mt) && mt != Focus
            }
            // (a mark being dragged is out of marks, drawn as the draft, until it is let go)
            None =>
              match draft.get() {
                Some(d) if d.id == id => !is_mosaic_tool(d.tool) && d.tool != Focus
                _ => true
              }
          }
        None => true
      }
    }
  }
  let init_grp = signals::untracked(active_grp)
  let init_col = signals::untracked(has_color)
  let shown_grp : signals::Signal[Int] = signals::signal(init_grp)
  let shown_col : signals::Signal[Bool] = signals::signal(init_col)

  let pill_w = motion::NodeWay::new(style_pill_width(init_grp, init_col))
  let left_w = motion::NodeWay::new(style_left_width(init_grp))
  let color_a = motion::NodeWay::new(if init_col { 1.0 } else { 0.0 })

  let shell_ref : signals::Ref[Option[view::View]] = signals::ref_new(None)
  let left_ref : signals::Ref[Option[view::View]] = signals::ref_new(None)
  let csec_ref : signals::Ref[Option[view::View]] = signals::ref_new(None)

  let _ = row.box(fn(shell) {
    shell_ref.v = Some(shell)
    let _ = shell
    .width(view::Live::By(fn() { Some(pill_w.shown(shell)) }))
    .height(view::Live::Is(Some(style_height)))
    .radius(view::Live::Is(style_corner))
    .ground(view::Live::Is(0x18191DF7L))
    .edge(view::Live::Is((1.0, 0xFFFFFF2EL)))
    .shadow(view::Live::Is((18.0, 4.0, 0x00000073L)))
    .presses(view::Live::Is(true))
    .cursor(view::Live::Is(Some(view::Cursor::Arrow)))

    let _ = shell.box(fn(clip) {
      let _ = clip
      .width(view::Live::By(fn() { Some(pill_w.shown(clip)) }))
      .height(view::Live::Is(Some(style_height)))
      .radius(view::Live::Is(style_corner))
      .clips(view::Live::Is(true))
      .pad(view::Live::Is(bar_pad))
      .row(view::Live::Is(true))
      .lines_up(view::Live::Is(Some(view::Along::Middle)))

      let _ = clip.box(fn(left_slot) {
        left_ref.v = Some(left_slot)
        let _ = left_slot
        .width(view::Live::By(fn() { Some(left_w.shown(left_slot)) }))
        .height(view::Live::Is(Some(28.0)))
        .shrink(view::Live::Is(0.0))
        .clips(view::Live::Is(true))
        sub_tool_strip(left_slot, shown_grp)
      })

      let sz_w = 3.0 * 28.0 + 2.0 * bar_gap
      let _ = clip.box(fn(sz_grp) {
        let _ = sz_grp
        .width(view::Live::Is(Some(sz_w)))
        .height(view::Live::Is(Some(28.0)))
        .shrink(view::Live::Is(0.0))
        .row(view::Live::Is(true))
        .gap(view::Live::Is(bar_gap))
        .lines_up(view::Live::Is(Some(view::Along::Middle)))
        let sz_views : Map[Int, view::View] = Map::new()
        sliding_thumb(
          sz_grp,
          fn() { size_now.get() },
          sz_views,
          style_btn_corner,
          fn() { 0xFFFFFF3DL },
          snap_watch=fn() { if bar_shown() { 1 } else { 0 } },
        )
        for s in 0..<3 {
          let _ = sz_grp.box(fn(b) {
            sz_views[s] = b
            let hov = smooth_hover(b, ms=100.0)
            tactile_press(b, sink_px=0.9)
            let _ = b
            .width(view::Live::Is(Some(28.0)))
            .height(view::Live::Is(Some(28.0)))
            .radius(view::Live::Is(style_btn_corner))
            .lines_up(view::Live::Is(Some(view::Along::Middle)))
            .lies_along(view::Live::Is(view::Lies::Middle))
            .presses(view::Live::Is(true))
            .cursor(view::Live::Is(Some(view::Cursor::Hand)))
            .says(view::Live::By(fn() { Some(view::said(view::Role::Button, label=tr(["细", "中", "粗"][s]))) }))
            .on_press(fn() {
              tip_off()
              size_now.set(s)
              restyle_selected(s=s)
            })
            .ground(view::Live::By(fn() { if size_now.get() == s { 0L } else { mix_rgba(0L, 0xFFFFFF20L, hov()) } }))
            tip_follows(b, fn() { ["细", "中", "粗"][s] }, view::Bottom)
            let d = [4.0, 7.0, 11.0][s]
            let _ = b.box(fn(dot) {
              let _ = dot.width(view::Live::Is(Some(d))).height(view::Live::Is(Some(d))).radius(view::Live::Is(d / 2.0)).ground(view::Live::Is(0xF0F2F6FFL))
            })
          })
        }
      })

      let col_w = bar_gap + bar_rule + bar_gap + colors.length().to_double() * 28.0 + (colors.length() - 1).to_double() * bar_gap
      let _ = clip.box(fn(csec) {
        csec_ref.v = Some(csec)
        let _ = csec
        .width(view::Live::Is(Some(col_w)))
        .height(view::Live::Is(Some(28.0)))
        .shrink(view::Live::Is(0.0))
        .padding(view::Live::Is((bar_gap, 0.0, 0.0, 0.0)))
        .row(view::Live::Is(true))
        .gap(view::Live::Is(bar_gap))
        .lines_up(view::Live::Is(Some(view::Along::Middle)))
        .alpha(view::Live::By(fn() { color_a.shown(csec) }))
        .presses(view::Live::By(fn() { shown_col.get() }))
        bar_rule_node(csec)
        for c in colors {
          let _ = csec.box(fn(b) {
            let live = fn() { shown_col.get() }
            let hov = smooth_hover(b, live=live, ms=100.0)
            tactile_press(b, live=live, sink_px=0.9)
            let _ = b
            .width(view::Live::Is(Some(28.0)))
            .height(view::Live::Is(Some(28.0)))
            .radius(view::Live::Is(style_btn_corner))
            .lines_up(view::Live::Is(Some(view::Along::Middle)))
            .lies_along(view::Live::Is(view::Lies::Middle))
            .presses(view::Live::By(live))
            .cursor(view::Live::By(fn() { if live() { Some(view::Cursor::Hand) } else { None } }))
            .says(view::Live::Is(Some(view::said(view::Role::Button, label=hex6((c >> 8).to_int())))))
            .on_press(fn() {
              if !shown_col.untracked() {
                return
              }
              color_now.set(c)
              restyle_selected(c=c)
            })
            .ground(view::Live::By(fn() { mix_rgba(0L, 0xFFFFFF17L, hov()) }))
            let _ = b.box(fn(sw) {
              let on_c = motion::eased_on(sw, fn() { color_now.get() == c }, motion::tween(120.0, ease=ui::Ease::Out))
              let _ = sw
              .width(view::Live::Is(Some(16.0)))
              .height(view::Live::Is(Some(16.0)))
              .radius(view::Live::Is(5.0))
              .ground(view::Live::Is(c))
              .scale(view::Live::By(fn() { 1.0 + 0.08 * on_c.shown(sw) }))
              .edge(view::Live::By(fn() {
                let p = on_c.shown(sw)
                (1.0 + p, mix_rgba(0xFFFFFF33L, 0xFFFFFFFFL, p))
              }))
            })
          })
        }
      })
    })
  })

  row.reacts(fn() { (styling(), active_grp(), has_color()) }, at_start=false, fn(st) {
    let (is_on, grp, col_on) = st
    if !is_on {
      return
    }
    shown_grp.set(grp)
    shown_col.set(col_on)
    let morph_spec = motion::tween(185.0, ease=ui::Ease::Out)
    match shell_ref.v {
      Some(sh) if sh.alive() => pill_w.go(sh, style_pill_width(grp, col_on), morph_spec)
      _ => ()
    }
    match left_ref.v {
      Some(ls) if ls.alive() => left_w.go(ls, style_left_width(grp), morph_spec)
      _ => ()
    }
    match csec_ref.v {
      Some(cs) if cs.alive() =>
        color_a.go(cs, if col_on { 1.0 } else { 0.0 }, motion::tween(if col_on { 155.0 } else { 115.0 }, ease=ui::Ease::Out))
      _ => ()
    }
  })
}

fn glyph(name : String) -> pixels::Vector {
  let lines = fn(paths : Array[String]) -> pixels::Vector {
    let layers : Array[pixels::VectorPath] = []
    for d in paths {
      layers.push(stroke_layer(d, 0x000000FFL, 1.6))
    }
    pixels::Vector::{ w: 18.0, h: 18.0, layers }
  }
  match name {
    "select" =>
      pixels::Vector::{
        w: 18.0,
        h: 18.0,
        layers: [stroke_layer("M5 2.8v11.4l2.9-2.8 2.1 4.6 2-.9-2.1-4.5h4z", 0x000000FFL, 1.4)],
      }
    "focus" =>
      pixels::Vector::{
        w: 18.0,
        h: 18.0,
        layers: [
          fill_layer("M2 3h14v12h-14zM6 6.5v5h6v-5z", 0x00000073L),
          stroke_layer("M6 6.5h6v5h-6z", 0x000000FFL, 1.6),
        ],
      }
    "box" => lines(["M3.5 4.5h11v9h-11z"])
    "oval" => lines([oval_path(2.5, 4.0, 13.0, 10.0)])
    "arrow" => lines(["M4 14 14 4", "M7.5 4H14v6.5"])
    "line" => lines(["M3.5 14.5 14.5 3.5"])
    "pen" => lines(["M3.5 14.5l1-3.5 8-8 2.5 2.5-8 8z", "M11 4.5l2.5 2.5"])
    "mosaic" =>
      pixels::Vector::{
        w: 18.0,
        h: 18.0,
        layers: [
          stroke_layer("M3.5 3.5h11v11h-11z", 0x000000FFL, 1.6),
          fill_layer("M3.5 3.5h3.7v3.7h-3.7zM10.8 3.5h3.7v3.7h-3.7zM7.2 7.2h3.6v3.6h-3.6zM3.5 10.8h3.7v3.7h-3.7zM10.8 10.8h3.7v3.7h-3.7z", 0x000000FFL),
        ],
      }
    "mosaic-brush" =>
      pixels::Vector::{
        w: 18.0,
        h: 18.0,
        layers: [
          fill_layer("M2.5 12.8h2.6v2.6H2.5zM5.6 12.8h2.6v2.6H5.6zM2.5 9.7h2.6v2.6H2.5z", 0x000000FFL),
          stroke_layer("M7.5 11.8l.9-3.1 5.6-5.6 2.2 2.2-5.6 5.6z", 0x000000FFL, 1.5),
        ],
      }
    "blur" =>
      pixels::Vector::{
        w: 18.0,
        h: 18.0,
        layers: [
          fill_layer(circle_path(9.0, 9.0, 6.2), 0x00000040L),
          stroke_layer(circle_path(9.0, 9.0, 6.2), 0x000000FFL, 1.5),
          fill_layer(circle_path(9.0, 9.0, 3.0), 0x0000008CL),
        ],
      }
    "number" =>
      pixels::Vector::{
        w: 18.0,
        h: 18.0,
        layers: [
          stroke_layer(circle_path(9.0, 9.0, 6.5), 0x000000FFL, 1.6),
          fill_layer("M8.3 6.4l1.6-1v7.4h-1.6z", 0x000000FFL),
        ],
      }
    "words" => lines(["M4 5V3.8h10V5", "M9 3.8v10.7", "M7 14.5h4"])
    "beautify" =>
      pixels::Vector::{
        w: 18.0,
        h: 18.0,
        layers: [
          stroke_layer(
            "M5.6 2.8h6.8c1.8 0 2.8 1 2.8 2.8v6.8c0 1.8-1 2.8-2.8 2.8H5.6c-1.8 0-2.8-1-2.8-2.8V5.6c0-1.8 1-2.8 2.8-2.8z",
            0x000000FFL,
            1.6,
          ),
          fill_layer("M7 6h4c.6 0 1 .4 1 1v4c0 .6-.4 1-1 1H7c-.6 0-1-.4-1-1V7c0-.6.4-1 1-1z", 0x000000FFL),
        ],
      }
    "ocr" => lines(["M2.8 6V2.8H6", "M12 2.8h3.2V6", "M15.2 12v3.2H12", "M6 15.2H2.8V12", "M6 6.5h6", "M9 6.5v5.5"])
    "undo" => lines(["M6.5 4 3 7.5 6.5 11", "M3.5 7.5h7a4 4 0 0 1 0 8H8"])
    "redo" => lines(["M11.5 4 15 7.5 11.5 11", "M14.5 7.5h-7a4 4 0 0 0 0 8H10"])
    "pin" => lines(["M7 2.8h4l-.6 4.6 2.6 2.4v1.4H5v-1.4l2.6-2.4z", "M9 11.2v4.3"])
    "save" => lines(["M9 3v8.5", "M5.5 8 9 11.5 12.5 8", "M3.5 13v1.7h11V13"])
    "folder" => lines(["M2.6 5.4a1.2 1.2 0 0 1 1.2-1.2h3.3l1.5 1.7h5.6a1.2 1.2 0 0 1 1.2 1.2v5.9a1.2 1.2 0 0 1-1.2 1.2H3.8a1.2 1.2 0 0 1-1.2-1.2z"])
    "close" => lines(["M4.5 4.5l9 9", "M13.5 4.5l-9 9"])
    "check" => pixels::Vector::{ w: 18.0, h: 18.0, layers: [stroke_layer("M3.5 9.5 7.3 13.2 14.5 5", 0x000000FFL, 2.0)] }
    "chevron-down" => pixels::Vector::{ w: 18.0, h: 18.0, layers: [stroke_layer("M4.5 6.8 9 11.3 13.5 6.8", 0x000000FFL, 2.0)] }
    "copy" => lines(["M6.5 6.5h8v8h-8z", "M11.5 6.5V3.5h-8v8h3"])
    "long" => lines(["M4 2.5h10v13h-10z", "M9 5.5v7", "M6.5 10 9 12.5 11.5 10"])
    "top" => lines(["M9 15V5", "M5 9l4-4 4 4", "M4 2.8h10"])
    "pause" => lines(["M6.5 4.2v9.6", "M11.5 4.2v9.6"])
    "play" => pixels::Vector::{ w: 18.0, h: 18.0, layers: [fill_layer("M6 4.2 14 9 6 13.8z", 0x000000FFL)] }
    "record" =>
      pixels::Vector::{
        w: 18.0,
        h: 18.0,
        layers: [
          stroke_layer(circle_path(9.0, 9.0, 6.2), 0x000000FFL, 1.5),
          fill_layer(circle_path(9.0, 9.0, 3.2), 0x000000FFL),
        ],
      }
    "stop" =>
      pixels::Vector::{
        w: 18.0,
        h: 18.0,
        layers: [fill_layer("M5.5 4.5h7c.6 0 1 .4 1 1v7c0 .6-.4 1-1 1h-7c-.6 0-1-.4-1-1v-7c0-.6.4-1 1-1z", 0x000000FFL)],
      }
    "speaker" => lines(["M3 7.2h2.8l3.7-3.2v10l-3.7-3.2H3z", "M12.2 6.8a3.2 3.2 0 0 1 0 4.4", "M14.3 4.8a6 6 0 0 1 0 8.4"])
    "speaker-off" => lines(["M3 7.2h2.8l3.7-3.2v10l-3.7-3.2H3z", "M12.2 7l3.3 4", "M15.5 7l-3.3 4"])
    "keycap" =>
      lines(["M2.5 4.5h13c.7 0 1.2.5 1.2 1.2v6.6c0 .7-.5 1.2-1.2 1.2h-13c-.7 0-1.2-.5-1.2-1.2V5.7c0-.7.5-1.2 1.2-1.2z", "M5.2 8h1.5", "M8.3 8h1.5", "M11.4 8h1.5", "M6 10.8h6"])
    "eraser" => lines(["M4.2 11.2 9.8 5.6a1.5 1.5 0 0 1 2.1 0l2.5 2.5a1.5 1.5 0 0 1 0 2.1l-3.6 3.6H6.8z", "M7.5 8l4 4", "M3.5 13.8h11"])
    "reset" => lines(["M4.2 7.5a5 5 0 1 1 1.2 4.9", "M4.2 3.8v3.7h3.7"])
    _ => lines([])
  }
}

let bar_tips : kit::TipLayer = kit::TipLayer::new()

fn ps_tip_look() -> kit::TipLook {
  kit::TipLook::{
    ground: 0x26282FF7L,
    ink: 0xECEEF2FFL,
    edge: (1.0, 0xFFFFFF18L),
    shadow: (8.0, 2.0, 0x00000048L),
    radius: 10.0,
    size: 12.0,
    line: 16.0,
    weight: 500,
    wrap: false,
    pad_x: 10.0,
    pad_y: 5.0,
    max_width: 300.0,
    cap_ground: 0xFFFFFF1FL,
    cap_ink: 0xE6E8EDFFL,
    cap_radius: 6.0,
    cap_size: 11.0,
    cap_line: 14.0,
    cap_weight: 500,
    cap_pad_x: 5.0,
    cap_over: 1.5,
    cap_in: 3.5,
    cap_gap: 2.0,
    cap_label_gap: 7.0,
    scale_from: 1.0,
    exit_scale: 0.97,
  }
}

fn ps_tip_shortcut(keys : String) -> String {
  if hostapi::platform() != 0 || keys == "" {
    return keys
  }
  let parts = keys.split("+")
  let out : Array[String] = []
  for raw in parts {
    let s = trim_ws(raw)
    if s == "Ctrl" {
      out.push("⌘")
    } else if s == "Alt" {
      out.push("⌥")
    } else if s == "Shift" {
      out.push("⇧")
    } else if s == "Enter" {
      out.push("Return")
    } else if s != "" {
      out.push(s)
    }
  }
  let sb = StringBuilder::new()
  for i, p in out {
    if i > 0 {
      sb.write_char('+')
    }
    sb.write_string(p)
  }
  sb.to_string()
}

fn ps_tip_follow(
  tips : kit::TipLayer,
  b : view::View,
  label : () -> String,
  side : view::Side,
  keys~ : () -> String  = fn() { "" },
  live~ : () -> Bool  = fn() { true },
) -> Unit {
  let _ = kit::tip_node(
    tips,
    b,
    fn() { tr(label()) },
    side=side,
    gap=6.0,
    edge_pad=4.0,
    shortcut=fn() { ps_tip_shortcut(keys()) },
    look=ps_tip_look,
    disabled=fn() { !live() },
  )
}

fn tip_off() -> Unit {
  bar_tips.dismiss()
}

fn tip_follows(b : view::View, label : () -> String, side : view::Side, keys~ : () -> String  = fn() { "" }) -> Unit {
  ps_tip_follow(bar_tips, b, label, side, keys=keys)
}

fn bar_tip_node(o : view::View) -> Unit {
  let _ = bar_tips.mount(o)
}
