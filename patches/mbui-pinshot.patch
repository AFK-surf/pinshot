+  inits[0] = {base, dw * 4, 0};
+  UINT mw = dw, mh = dh;
+  const uint8_t *prev = base;
+  uint8_t *tmp = mips > 1 ? (uint8_t *)malloc((size_t)(dw > 1 ? (dw >> 1) : 1) * dh * 4) : NULL;
+  for (UINT level = 1; level < mips; level++) {
+    UINT nw = mw > 1 ? (mw >> 1) : 1;
+    UINT nh = mh > 1 ? (mh >> 1) : 1;
+    uint8_t *dst = (uint8_t *)malloc((size_t)nw * nh * 4);
+    if (!dst || !tmp) {
+      free(dst);
+      mips = level;
+      break;
+    }
+    mip_bufs[level] = dst;
+    for (UINT y = 0; y < mh; y++) {
+      const uint8_t *r = prev + (size_t)y * mw * 4;
+      uint8_t *out = tmp + (size_t)y * nw * 4;
+      if (mw == 1) {
+        memcpy(out, r, 4);
+      } else {
+        for (UINT x = 0; x < nw; x++) {
+          UINT x0 = x * 2;
+          UINT xm1 = x0 > 0 ? x0 - 1 : 0;
+          UINT xp1 = x0 + 1 < mw ? x0 + 1 : mw - 1;
+          UINT xp2 = x0 + 2 < mw ? x0 + 2 : mw - 1;
+          const uint8_t *a = r + xm1 * 4, *b = r + x0 * 4, *c = r + xp1 * 4, *d = r + xp2 * 4;
+          uint8_t al = opaque ? 255 : clamp_u8((-a[3] + 9 * b[3] + 9 * c[3] - d[3] + 8) >> 4);
+          uint8_t c0 = clamp_u8((-a[0] + 9 * b[0] + 9 * c[0] - d[0] + 8) >> 4);
+          uint8_t c1 = clamp_u8((-a[1] + 9 * b[1] + 9 * c[1] - d[1] + 8) >> 4);
+          uint8_t c2 = clamp_u8((-a[2] + 9 * b[2] + 9 * c[2] - d[2] + 8) >> 4);
+          if (!opaque) {
+            if (c0 > al) c0 = al;
+            if (c1 > al) c1 = al;
+            if (c2 > al) c2 = al;
+          }
+          out[x * 4 + 0] = c0;
+          out[x * 4 + 1] = c1;
+          out[x * 4 + 2] = c2;
+          out[x * 4 + 3] = al;
+        }
+      }
+    }
+    for (UINT y = 0; y < nh; y++) {
+      uint8_t *out = dst + (size_t)y * nw * 4;
+      if (mh == 1) {
+        memcpy(out, tmp, (size_t)nw * 4);
+      } else {
+        UINT y0 = y * 2;
+        UINT ym1 = y0 > 0 ? y0 - 1 : 0;
+        UINT yp1 = y0 + 1 < mh ? y0 + 1 : mh - 1;
+        UINT yp2 = y0 + 2 < mh ? y0 + 2 : mh - 1;
+        const uint8_t *ra = tmp + (size_t)ym1 * nw * 4;
+        const uint8_t *rb = tmp + (size_t)y0 * nw * 4;
+        const uint8_t *rc = tmp + (size_t)yp1 * nw * 4;
+        const uint8_t *rd = tmp + (size_t)yp2 * nw * 4;
+        for (UINT x = 0; x < nw; x++) {
+          const uint8_t *a = ra + x * 4, *b = rb + x * 4, *c = rc + x * 4, *d = rd + x * 4;
+          uint8_t al = opaque ? 255 : clamp_u8((-a[3] + 9 * b[3] + 9 * c[3] - d[3] + 8) >> 4);
+          uint8_t c0 = clamp_u8((-a[0] + 9 * b[0] + 9 * c[0] - d[0] + 8) >> 4);
+          uint8_t c1 = clamp_u8((-a[1] + 9 * b[1] + 9 * c[1] - d[1] + 8) >> 4);
+          uint8_t c2 = clamp_u8((-a[2] + 9 * b[2] + 9 * c[2] - d[2] + 8) >> 4);
+          if (!opaque) {
+            if (c0 > al) c0 = al;
+            if (c1 > al) c1 = al;
+            if (c2 > al) c2 = al;
+          }
+          out[x * 4 + 0] = c0;
+          out[x * 4 + 1] = c1;
+          out[x * 4 + 2] = c2;
+          out[x * 4 + 3] = al;
+        }
+      }
+    }
+    inits[level] = {dst, nw * 4, 0};
+    prev = dst;
+    mw = nw;
+    mh = nh;
+  }
+  free(tmp);
+  return mips;
