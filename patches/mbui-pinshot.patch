+// the 28 above then the hook's address and its argument. The program frees them once no job holds them, never on a
+// guess of how long a decode takes.
+typedef void (*RawHook)(void *ctx, int op);
+static void raw_hook(const Job *j, int op) {
+  if (!j->data || j->len < 44 || memcmp(j->data, "MBRAWPTR", 8)) return;
